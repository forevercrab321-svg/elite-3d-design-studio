{
  "name": "GrowEverything",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 16.5,
        "Brightness": 2,
        "GlobalShadows": true
      }
    }
  }
}
