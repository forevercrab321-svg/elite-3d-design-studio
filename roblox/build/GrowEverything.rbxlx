		"0.12*33,0*14,0.12*39,0*20,0.12*39,0*14,0.12*33",
		"0.12*33,0*14,0.12*39,0*20,0.12*39,0*14,0.12*33",
		"0.12*33,0*14,0.12*39,0*20,0.12*39,0*14,0.12*33",
	} },
}
]]></string>
