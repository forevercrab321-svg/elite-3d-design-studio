	Landmark_Eiffel = { group = "landmark", size = Vector3.new(23.6, 68.588, 23.6), meshes = { ["paint_0"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["concreteProp_1"] = { c = "#35291c", m = "Concrete", t = 0 }, ["paint_2"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["concreteProp_3"] = { c = "#35291c", m = "Concrete", t = 0 }, ["paint_4"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["concreteProp_5"] = { c = "#35291c", m = "Concrete", t = 0 }, ["paint_6"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["concreteProp_7"] = { c = "#35291c", m = "Concrete", t = 0 }, ["paint_8"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["glass_9"] = { c = "#1b2328", m = "Glass", t = 0 }, ["tread_10"] = { c = "#232325", m = "Rubber", t = 0 }, ["paint_11"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["tread_12"] = { c = "#232325", m = "Rubber", t = 0 }, ["paint_13"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["paint_14"] = { c = "#624f3c", m = "SmoothPlastic", t = 0 }, ["glass_15"] = { c = "#1b2328", m = "Glass", t = 0 }, ["steel_16"] = { c = "#a9afb5", m = "Metal", t = 0 }, ["lamps_17"] = { c = "#ffffff", m = "Neon", t = 0 } } },
} :: { [string]: Info }
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">City</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural city: a GRID × GRID block layout with roads and lane markings, paved blocks and sidewalks,
-- street props, traffic, paved blocks, colourful buildings with window bands in the block quadrants, and three
-- landmarks (Oriental Pearl Tower, Empire State Building, Eiffel Tower) on their own blocks.
-- Props and landmarks use the web game's own models (server/Models) and fall back to primitives
-- for any model that is not uploaded yet.
-- Every edible is a Model in the Edibles folder carrying Size (largest dimension, studs), Mass
-- (reward), Kind and Respawn attributes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Models = require(script.Parent:WaitForChild("Models"))

local City = {}

local GRID = Config.GRID
local BLOCK = Config.BLOCK
local ROAD = Config.ROAD
local TOTAL = GRID * BLOCK + (GRID + 1) * ROAD
local HALF = TOTAL / 2
local SIDEWALK_TOP = 0.4

local rng = Random.new()
local freeSlots: { Vector3 } = {}

local function blockCenter(i: number, j: number): Vector3
	local x = -HALF + ROAD + i * (BLOCK + ROAD) + BLOCK / 2
	local z = -HALF + ROAD + j * (BLOCK + ROAD) + BLOCK / 2
	return Vector3.new(x, 0, z)
end

local function isLandmarkBlock(i: number, j: number): boolean
	for _, l in Config.LANDMARKS do
		if l.block[1] == i and l.block[2] == j then
			return true
		end
	end
	return false
end

local function pick<T>(list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function ball(parent: Instance, name: string, d: number, cf: CFrame, color: Color3, material: Enum.Material): Part
	local p = part(parent, name, Vector3.new(d, d, d), cf, color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

function City.reward(size: number): number
	return Config.REWARD_FACTOR * size ^ Config.REWARD_EXP
end

-- Static ground: asphalt with lane markings, paved blocks, edge walls.
local function buildGround(folder: Folder)
	part(folder, "Asphalt", Vector3.new(TOTAL, 2, TOTAL), CFrame.new(0, -1, 0), Color3.fromRGB(52, 55, 62), Enum.Material.Asphalt)
	-- Dashed centre lines on every road.
	local white = Color3.fromRGB(235, 235, 220)
	for k = 0, GRID do
		local line = -HALF + ROAD / 2 + k * (BLOCK + ROAD)
		for d = -HALF + 10, HALF - 10, 16 do
			part(folder, "Lane", Vector3.new(0.6, 0.05, 7), CFrame.new(line, 0.03, d), white, Enum.Material.SmoothPlastic)
			part(folder, "Lane", Vector3.new(7, 0.05, 0.6), CFrame.new(d, 0.03, line), white, Enum.Material.SmoothPlastic)
		end
	end
	for i = 0, GRID - 1 do
		for j = 0, GRID - 1 do
			local c = blockCenter(i, j)
			part(folder, "Sidewalk", Vector3.new(BLOCK, SIDEWALK_TOP, BLOCK), CFrame.new(c.X, SIDEWALK_TOP / 2, c.Z), Color3.fromRGB(190, 188, 180), Enum.Material.Concrete)
			-- Paved plazas like the web game's city blocks; landmark blocks get a warmer stone.
			local plazaColor = if isLandmarkBlock(i, j) then Color3.fromRGB(205, 195, 170) else Color3.fromRGB(176, 174, 168)
			part(folder, "Plaza", Vector3.new(BLOCK - 12, 0.1, BLOCK - 12), CFrame.new(c.X, SIDEWALK_TOP + 0.05, c.Z), plazaColor, Enum.Material.Pavement)
		end
	end
	local wallH = 600
	for _, d in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local size = if d.X ~= 0 then Vector3.new(4, wallH, TOTAL) else Vector3.new(TOTAL, wallH, 4)
		local w = part(folder, "Wall", size, CFrame.new(d * (HALF + 2) + Vector3.new(0, wallH / 2, 0)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		w.Transparency = 1
	end
end

local function sidewalkSpot(): Vector3
	local i, j = rng:NextInteger(0, GRID - 1), rng:NextInteger(0, GRID - 1)
	local c = blockCenter(i, j)
	local edge = BLOCK / 2 - 3
	local along = rng:NextNumber(-edge, edge)
	local side = rng:NextInteger(1, 4)
	local off = if side == 1 then Vector3.new(edge, 0, along) elseif side == 2 then Vector3.new(-edge, 0, along) elseif side == 3 then Vector3.new(along, 0, edge) else Vector3.new(along, 0, -edge)
	return Vector3.new(c.X + off.X, SIDEWALK_TOP, c.Z + off.Z)
end

local function roadSpot(): (Vector3, number)
	local k = rng:NextInteger(0, GRID)
	local line = -HALF + ROAD / 2 + k * (BLOCK + ROAD)
	local along = rng:NextNumber(-HALF + ROAD, HALF - ROAD)
	local lane = (if rng:NextNumber() < 0.5 then -1 else 1) * ROAD / 4
	if rng:NextNumber() < 0.5 then
		return Vector3.new(line + lane, 0, along), 0 -- driving along Z
	end
	return Vector3.new(along, 0, line + lane), math.pi / 2 -- driving along X
end

-- Visual detail per kind: the body is always the first part; extras only add shape language.
local function decorate(m: Model, kind: Config.PropKind, base: CFrame, color: Color3)
	local dims = kind.dims
	if kind.where == "block" then
		local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
		part(m, "Roof", Vector3.new(dims.X + 1, 1.2, dims.Z + 1), base * CFrame.new(0, dims.Y / 2 + 0.6, 0), dark, Enum.Material.Slate)
		-- One glass band per floor wraps all four faces.
		local floors = math.clamp(math.floor(dims.Y / 6), 2, 16)
		local glass = Color3.fromRGB(170, 210, 235)
		for f = 1, floors - 1 do
			local y = -dims.Y / 2 + f * (dims.Y / floors)
			part(m, "Windows", Vector3.new(dims.X + 0.3, 1.4, dims.Z + 0.3), base * CFrame.new(0, y, 0), glass, Enum.Material.Glass).Transparency = 0.15
		end
		part(m, "Door", Vector3.new(4, 6, 0.4), base * CFrame.new(0, -dims.Y / 2 + 3, -dims.Z / 2 - 0.2), dark, Enum.Material.Wood)
	elseif kind.name == "Tree" then
		-- The body is the trunk; the canopy sits on top.
		ball(m, "Canopy", dims.X * 1.3, base * CFrame.new(0, dims.Y / 2, 0), color, Enum.Material.Grass)
	elseif kind.where == "road" and dims.Z > dims.X * 1.5 then
		part(m, "Cabin", Vector3.new(dims.X * 0.9, dims.Y * 0.4, dims.Z * 0.45), base * CFrame.new(0, dims.Y * 0.45, -dims.Z * 0.08), Color3.fromRGB(160, 205, 235), Enum.Material.Glass)
		local r = math.min(dims.Y * 0.45, 2.4)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				local w = part(m, "Wheel", Vector3.new(0.8, r, r), base * CFrame.new(sx * dims.X / 2, -dims.Y / 2 + r / 2 - 0.3, sz * dims.Z * 0.32), Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic)
				w.Shape = Enum.PartType.Cylinder
			end
		end
	end
end

local function finish(m: Model, body: BasePart, size: number, kind: string, respawn: boolean, edibles: Folder)
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			-- Small things never block anyone (they get eaten on contact); big ones do.
			p.CanCollide = size >= 4
		end
	end
	m.PrimaryPart = body
	m:SetAttribute("Size", size)
	m:SetAttribute("Mass", City.reward(size))
	m:SetAttribute("Kind", kind)
	m:SetAttribute("Respawn", respawn)
	m.Parent = edibles
end

-- The largest part anchors the model (PrimaryPart).
local function largestPart(m: Model): BasePart?
	local best: BasePart? = nil
	local bestVolume = -1
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			local v = p.Size.X * p.Size.Y * p.Size.Z
			if v > bestVolume then
				best, bestVolume = p, v
			end
		end
	end
	return best
end

local function makeProp(kind: Config.PropKind, edibles: Folder, position: Vector3, yaw: number): Model
	local model = if kind.model then Models.clone(kind.model, kind.size) else nil
	local main = model and largestPart(model)
	if model and main then
		model.Name = kind.name
		model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
		finish(model, main, kind.size, kind.name, kind.respawn, edibles)
		return model
	end
	local m = Instance.new("Model")
	m.Name = kind.name
	local dims = kind.dims
	local color = kind.color
	if kind.where == "block" then
		color = pick(Config.BUILDING_COLORS)
	elseif kind.where == "road" and dims.Z > dims.X * 1.5 and kind.name ~= "Bus" then
		color = pick(Config.VEHICLE_COLORS)
	end
	local base = CFrame.new(position + Vector3.new(0, dims.Y / 2, 0)) * CFrame.Angles(0, yaw, 0)
	local body: Part
	if kind.name == "Tree" then
		body = part(m, "Trunk", Vector3.new(dims.X * 0.25, dims.Y, dims.X * 0.25), base, Color3.fromRGB(110, 80, 50), Enum.Material.Wood)
	else
		body = part(m, "Body", dims, base, color, kind.material)
	end
	decorate(m, kind, base, color)
	finish(m, body, kind.size, kind.name, kind.respawn, edibles)
	return m
end

function City.spawn(kind: Config.PropKind, edibles: Folder): Model?
	if kind.where == "sidewalk" then
		return makeProp(kind, edibles, sidewalkSpot(), rng:NextNumber(0, math.pi * 2))
	elseif kind.where == "road" then
		local pos, yaw = roadSpot()
		return makeProp(kind, edibles, pos, yaw)
	end
	if #freeSlots == 0 then
		return nil
	end
	local slot = table.remove(freeSlots, rng:NextInteger(1, #freeSlots)) :: Vector3
	return makeProp(kind, edibles, slot, rng:NextInteger(0, 3) * math.pi / 2)
end

-- Landmarks ----------------------------------------------------------------------------------

local function pearl(m: Model, c: Vector3, h: number): BasePart
	local pink = Color3.fromRGB(230, 90, 150)
	local steel = Color3.fromRGB(200, 205, 215)
	local base = part(m, "Base", Vector3.new(44, 6, 44), CFrame.new(c.X, SIDEWALK_TOP + 3, c.Z), Color3.fromRGB(150, 150, 160), Enum.Material.Concrete)
	local y0 = SIDEWALK_TOP + 6
	-- Three slanted legs up to the lower sphere.
	for a = 0, 2 do
		local ang = a * math.pi * 2 / 3
		local foot = Vector3.new(c.X + math.cos(ang) * 16, y0, c.Z + math.sin(ang) * 16)
		local top = Vector3.new(c.X, y0 + h * 0.28, c.Z)
		local mid = (foot + top) / 2
		part(m, "Leg", Vector3.new(4, 4, (top - foot).Magnitude), CFrame.lookAt(mid, top), steel, Enum.Material.Metal)
	end
	part(m, "Column", Vector3.new(7, h * 0.78, 7), CFrame.new(c.X, y0 + h * 0.39, c.Z), steel, Enum.Material.Metal)
	ball(m, "LowerSphere", h * 0.2, CFrame.new(c.X, y0 + h * 0.28, c.Z), pink, Enum.Material.Glass)
	ball(m, "UpperSphere", h * 0.13, CFrame.new(c.X, y0 + h * 0.66, c.Z), pink, Enum.Material.Glass)
	ball(m, "TopSphere", h * 0.05, CFrame.new(c.X, y0 + h * 0.8, c.Z), pink, Enum.Material.Glass)
	part(m, "Spire", Vector3.new(1.5, h * 0.18, 1.5), CFrame.new(c.X, y0 + h * 0.89, c.Z), steel, Enum.Material.Metal)
	return base
end

local function empire(m: Model, c: Vector3, h: number): BasePart
	local stone = Color3.fromRGB(205, 195, 175)
	local glass = Color3.fromRGB(150, 185, 210)
	local y = SIDEWALK_TOP
	local base: BasePart? = nil
	-- Setbacks: each tier narrower and the top tiers taller.
	local tiers = { { 50, 0.18 }, { 40, 0.22 }, { 30, 0.3 }, { 20, 0.1 } }
	for idx, t in tiers do
		local w, frac = t[1], t[2]
		local th = h * frac
		local p = part(m, "Tier" .. idx, Vector3.new(w, th, w), CFrame.new(c.X, y + th / 2, c.Z), stone, Enum.Material.Limestone)
		for f = 1, math.floor(th / 6) do
			part(m, "Windows", Vector3.new(w + 0.3, 1.2, w + 0.3), CFrame.new(c.X, y + f * 6 - 2, c.Z), glass, Enum.Material.Glass)
		end
		base = base or p
		y += th
	end
	part(m, "Mast", Vector3.new(4, h * 0.1, 4), CFrame.new(c.X, y + h * 0.05, c.Z), stone, Enum.Material.Metal)
	part(m, "Antenna", Vector3.new(1, h * 0.1, 1), CFrame.new(c.X, y + h * 0.15, c.Z), Color3.fromRGB(230, 60, 60), Enum.Material.Neon)
	return base :: BasePart
end

local function eiffel(m: Model, c: Vector3, h: number): BasePart
	local iron = Color3.fromRGB(140, 105, 70)
	local y0 = SIDEWALK_TOP
	local base = part(m, "Plaza", Vector3.new(60, 1, 60), CFrame.new(c.X, y0 + 0.5, c.Z), Color3.fromRGB(205, 195, 170), Enum.Material.Pavement)
	-- Four legs that lean in to the first platform, then a tapering mast.
	local spread, p1 = 24, h * 0.25
	for _, s in { Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) } do
		local foot = Vector3.new(c.X + s.X * spread, y0 + 1, c.Z + s.Z * spread)
		local top = Vector3.new(c.X + s.X * 8, y0 + p1, c.Z + s.Z * 8)
		part(m, "Leg", Vector3.new(5, 5, (top - foot).Magnitude), CFrame.lookAt((foot + top) / 2, top), iron, Enum.Material.Metal)
	end
	part(m, "Platform1", Vector3.new(26, 3, 26), CFrame.new(c.X, y0 + p1, c.Z), iron, Enum.Material.Metal)
	part(m, "Section2", Vector3.new(14, h * 0.3, 14), CFrame.new(c.X, y0 + p1 + h * 0.15, c.Z), iron, Enum.Material.Metal)
	part(m, "Platform2", Vector3.new(18, 2, 18), CFrame.new(c.X, y0 + p1 + h * 0.3, c.Z), iron, Enum.Material.Metal)
	part(m, "Section3", Vector3.new(7, h * 0.35, 7), CFrame.new(c.X, y0 + p1 + h * 0.3 + h * 0.175, c.Z), iron, Enum.Material.Metal)
	part(m, "Tip", Vector3.new(2, h * 0.1, 2), CFrame.new(c.X, y0 + p1 + h * 0.65 + h * 0.05, c.Z), Color3.fromRGB(240, 210, 120), Enum.Material.Neon)
	return base
end

local BUILDERS: { [string]: (Model, Vector3, number) -> BasePart } = { pearl = pearl, empire = empire, eiffel = eiffel }

local function buildLandmarks(edibles: Folder)
	for _, l in Config.LANDMARKS do
		local m = Instance.new("Model")
		m.Name = l.name
		local c = blockCenter(l.block[1], l.block[2])
		local model = Models.clone(l.model, l.size)
		local main = model and largestPart(model)
		local build = BUILDERS[l.style]
		if model and main then
			m:Destroy()
			model.Name = l.name
			model:PivotTo(CFrame.new(c.X, SIDEWALK_TOP, c.Z))
			finish(model, main, l.size, l.name, false, edibles)
			model:SetAttribute("Landmark", true)
		elseif build then
			local body = build(m, c, l.size)
			finish(m, body, l.size, l.name, false, edibles)
			m:SetAttribute("Landmark", true)
		end
	end
end

-- (Re)build the whole city; returns the Edibles folder.
function City.build(): Folder
	local old = workspace:FindFirstChild("City")
	if old then
		old:Destroy()
	end
	local city = Instance.new("Folder")
	city.Name = "City"
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = city
	local edibles = Instance.new("Folder")
	edibles.Name = "Edibles"
	edibles.Parent = city
	buildGround(ground)
	local names: { string } = {}
	for _, kind in Config.PROPS do
		if kind.model then
			table.insert(names, kind.model)
		end
	end
	for _, l in Config.LANDMARKS do
		table.insert(names, l.model)
	end
	Models.preload(names)

	freeSlots = {}
	local q = BLOCK / 4
	for i = 0, GRID - 1 do
		for j = 0, GRID - 1 do
			if not isLandmarkBlock(i, j) then
				local c = blockCenter(i, j)
				for _, o in { Vector3.new(q, 0, q), Vector3.new(-q, 0, q), Vector3.new(q, 0, -q), Vector3.new(-q, 0, -q) } do
					table.insert(freeSlots, Vector3.new(c.X + o.X, SIDEWALK_TOP, c.Z + o.Z))
				end
			end
		end
	end

	for _, kind in Config.PROPS do
		for _ = 1, kind.count do
			City.spawn(kind, edibles)
		end
	end
	buildLandmarks(edibles)
	city.Parent = workspace
	return edibles
end

-- A random spot on a road, high enough to drop in safely.
function City.spawnPoint(): Vector3
	local pos = roadSpot()
	return pos + Vector3.new(0, 6, 0)
end

function City.kind(name: string): Config.PropKind?
	for _, k in Config.PROPS do
		if k.name == name then
			return k
		end
	end
	return nil
end

return City
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Machine</string>
          <string name="Source"><![CDATA[--!strict
-- The player's machine. The Roblox character stays (it does the walking and the physics) but turns
-- invisible; the machine is welded to the root part inside the character model, so Model:ScaleTo
-- grows the two together. It is the web game's own model (Machine_<look>_T<tier>, swapped for the
-- next tier as the player grows) or, while that model is not uploaded, a primitive googly-eyed one.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Models = require(script.Parent:WaitForChild("Models"))

local Machine = {}

local function weldedPart(parent: Instance, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = root.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = parent
	return p
end

-- Hide the default body (and face/accessories) so only the machine shows.
function Machine.hideBody(char: Model)
	local machine = char:FindFirstChild("Machine")
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not (machine and d:IsDescendantOf(machine)) then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
end

local function tierFor(scale: number): number
	local tier = 1
	for n, from in Config.MACHINE_TIER_SCALES do
		if scale >= from then
			tier = n
		end
	end
	return tier
end

-- The web model for this look and scale, welded under the root part with its wheels on the ground.
local function attachModel(char: Model, root: BasePart, look: string, scale: number): boolean
	local hum = char:FindFirstChildOfClass("Humanoid")
	local tier = tierFor(scale)
	local m = Models.clone(string.format("Machine_%s_T%d", look, tier), Config.MACHINE_SIZE * scale)
	if not hum or not m then
		return false
	end
	local ground = hum.HipHeight + root.Size.Y / 2
	m:PivotTo(root.CFrame * CFrame.new(0, -ground, 0) * CFrame.Angles(0, math.rad(Config.MACHINE_YAW), 0))
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
		end
	end
	m.Name = "Machine"
	m:SetAttribute("Look", look)
	m:SetAttribute("Tier", tier)
	m.Parent = char
	return true
end

-- Build the machine for the character's current scale.
function Machine.attach(char: Model, look: string, color: Color3)
	local root = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root or char:FindFirstChild("Machine") then
		return
	end
	if attachModel(char, root, look, char:GetScale()) then
		Machine.hideBody(char)
		return
	end
	local m = Instance.new("Model")
	m.Name = "Machine"
	-- The root part sits about 3 studs above the ground at scale 1; build down from there.
	local dark = Color3.fromRGB(35, 35, 40)
	weldedPart(m, root, "Chassis", Vector3.new(3.6, 2.2, 4.6), CFrame.new(0, -1.6, 0), color, Enum.Material.SmoothPlastic)
	weldedPart(m, root, "Hood", Vector3.new(3.2, 0.6, 1.6), CFrame.new(0, -0.3, -1.2), color:Lerp(Color3.new(1, 1, 1), 0.2), Enum.Material.SmoothPlastic)
	weldedPart(m, root, "Intake", Vector3.new(3.8, 1.2, 0.6), CFrame.new(0, -2.2, -2.5), dark, Enum.Material.Metal)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local w = weldedPart(m, root, "Wheel", Vector3.new(0.7, 1.6, 1.6), CFrame.new(sx * 2.05, -2.2, sz * 1.5), dark, Enum.Material.SmoothPlastic)
			w.Shape = Enum.PartType.Cylinder
		end
		-- Googly eyes: big white balls on stalks, pupils looking forward.
		weldedPart(m, root, "Stalk", Vector3.new(0.25, 1.0, 0.25), CFrame.new(sx * 0.8, 0.2, -0.6), dark, Enum.Material.Metal)
		local eye = weldedPart(m, root, "Eye", Vector3.new(1.4, 1.4, 1.4), CFrame.new(sx * 0.8, 0.9, -0.7), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
		eye.Shape = Enum.PartType.Ball
		local pupil = weldedPart(m, root, "Pupil", Vector3.new(0.6, 0.6, 0.6), CFrame.new(sx * 0.8, 0.9, -1.3), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
		pupil.Shape = Enum.PartType.Ball
	end
	m.Parent = char
	Machine.hideBody(char)
end

-- After the character was scaled: swap in the next tier's model when growth crossed a threshold.
function Machine.update(char: Model, scale: number)
	local current = char:FindFirstChild("Machine")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local look = current and current:GetAttribute("Look") :: string?
	if not current or not root or not look or current:GetAttribute("Tier") == tierFor(scale) then
		return
	end
	current:Destroy()
	if not attachModel(char, root, look, scale) then
		warn("Machine: tier model missing for " .. look)
	end
end

function Machine.look(index: number): string
	local list = Config.MACHINE_LOOKS
	return list[(index - 1) % #list + 1]
end

function Machine.color(index: number): Color3
	local list = Config.MACHINE_COLORS
	return list[(index - 1) % #list + 1]
end

return Machine
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox) server: rounds, eating, growth, PvP and the cosmetic game pass.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local City = require(script.Parent:WaitForChild("City"))
local Machine = require(script.Parent:WaitForChild("Machine"))

-- Remotes (server → client only; the client never decides what was eaten).
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in Config.REMOTES do
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotes
end
remotes.Parent = ReplicatedStorage
local AteEvent = remotes:WaitForChild("Ate") :: RemoteEvent
local EatenEvent = remotes:WaitForChild("Eaten") :: RemoteEvent
local RoundEvent = remotes:WaitForChild("RoundState") :: RemoteEvent

local mass: { [Player]: number } = {}
local colorIndex: { [Player]: number } = {}
local joined = 0
local appliedScale: { [Player]: number } = {}
local roundActive = false
-- Filled by the round loop: City.build waits for the models to load, which must not delay the
-- player handlers below (a player who joins during that wait would get no machine).
local edibles: Folder = Instance.new("Folder")

local function scaleFor(m: number): number
	return math.clamp((m / Config.START_MASS) ^ (1 / 3), 1, Config.MAX_SCALE)
end

local function reach(scale: number): number
	return Config.EAT_REACH * Config.CHARACTER_HEIGHT * scale
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	return if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function updateStats(player: Player)
	local ls = player:FindFirstChild("leaderstats")
	local size = ls and ls:FindFirstChild("Size") :: IntValue?
	if size then
		size.Value = math.floor(mass[player] or 0)
	end
	player:SetAttribute("Mass", mass[player] or 0)
end

-- Scale the character only when it changed noticeably (ScaleTo is not free).
local function applyScale(player: Player, force: boolean?)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum then
		return
	end
	local s = scaleFor(mass[player] or Config.START_MASS)
	local last = appliedScale[player] or 1
	if not force and math.abs(s - last) / last < 0.02 then
		return
	end
	appliedScale[player] = s
	pcall(function()
		char:ScaleTo(s)
	end)
	Machine.update(char, s)
	hum.WalkSpeed = math.min(Config.MAX_WALKSPEED, Config.BASE_WALKSPEED + Config.WALKSPEED_PER_SCALE * (s - 1))
	-- Web-game follow distance for this machine size (Config CAMERA_*).
	local size = Config.MACHINE_SIZE * s
	local back = Config.CAMERA_DIST_BASE + Config.CAMERA_DIST_PER_SIZE * size
	local up = Config.CAMERA_HEIGHT_BASE + Config.CAMERA_HEIGHT_PER_SIZE * size
	local zoom = math.sqrt(back * back + up * up)
	player.CameraMaxZoomDistance = zoom * (1 + Config.CAMERA_ZOOM_RANGE)
	player.CameraMinZoomDistance = zoom * (1 - Config.CAMERA_ZOOM_RANGE)
	player:SetAttribute("Scale", s)
end

local function addMass(player: Player, amount: number)
	mass[player] = (mass[player] or Config.START_MASS) + amount
	updateStats(player)
	applyScale(player)
end

local function resetPlayer(player: Player)
	mass[player] = Config.START_MASS
	appliedScale[player] = nil
	updateStats(player)
end

local function placeAtSpawn(player: Player)
	local root = rootOf(player)
	if root then
		root.CFrame = CFrame.new(City.spawnPoint())
	end
end

-- Cosmetic game pass: a trail behind the player. Never affects size or speed.
local function giveTrail(player: Player, char: Model)
	if Config.GAMEPASS_VIP_TRAIL == 0 then
		return
	end
	local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, Config.GAMEPASS_VIP_TRAIL)
	if not ok or not owns then
		return
	end
	local root = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not root then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 80, 160))
	trail.Parent = root
end

local function onCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	-- Fresh character = fresh start (death by falling, being eaten, or a new round).
	resetPlayer(player)
	Machine.attach(char, Machine.look(colorIndex[player] or 1), Machine.color(colorIndex[player] or 1))
	task.defer(function()
		placeAtSpawn(player)
		applyScale(player, true)
	end)
	giveTrail(player, char)
	hum.Died:Connect(function()
		resetPlayer(player)
	end)
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local size = Instance.new("IntValue")
	size.Name = "Size"
	size.Parent = ls
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = ls
	ls.Parent = player
	joined += 1
	colorIndex[player] = joined
	resetPlayer(player)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	-- Anything the avatar loads later (hats, faces) is hidden too.
	player.CharacterAppearanceLoaded:Connect(function(char)
		Machine.hideBody(char)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
-- Anyone who joined before this script got here (Studio Play joins immediately).
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player: Player)
	mass[player] = nil
	appliedScale[player] = nil
	colorIndex[player] = nil
end)

-- Eating ------------------------------------------------------------------------------------

local function respawnLater(kindName: string)
	local kind = City.kind(kindName)
	if not kind or not kind.respawn then
		return
	end
	task.delay(Config.RESPAWN_SECONDS, function()
		if edibles.Parent then
			City.spawn(kind, edibles)
		end
	end)
end

local function eatModel(player: Player, model: Model)
	local size = model:GetAttribute("Size") :: number? or 0
	local gain = model:GetAttribute("Mass") :: number? or 0
	local kind = model:GetAttribute("Kind") :: string? or model.Name
	local respawn = model:GetAttribute("Respawn") == true
	local isLandmark = model:GetAttribute("Landmark") == true
	local pos = model:GetPivot().Position
	model:Destroy()
	addMass(player, gain)
	AteEvent:FireClient(player, kind, gain, pos, size)
	if respawn then
		respawnLater(kind)
	end
	if isLandmark then
		RoundEvent:FireAllClients({ phase = "Landmark", name = player.DisplayName, landmark = kind })
	end
end

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local function eatTick()
	if not roundActive then
		return
	end
	overlap.FilterDescendantsInstances = { edibles }
	for player, m in mass do
		local root = rootOf(player)
		if root then
			local s = scaleFor(m)
			local r = Config.EAT_RADIUS * Config.CHARACTER_HEIGHT * s + 1
			local limit = reach(s)
			local seen: { [Model]: boolean } = {}
			for _, p in workspace:GetPartBoundsInRadius(root.Position, r, overlap) do
				local model = p:FindFirstAncestorOfClass("Model")
				if model and model.Parent == edibles and not seen[model] then
					seen[model] = true
					local size = model:GetAttribute("Size") :: number?
					if size and size <= limit then
						eatModel(player, model)
					end
				end
			end
		end
	end
	-- PvP: a clearly bigger player swallows a smaller one on contact.
	local list = Players:GetPlayers()
	for _, a in list do
		for _, b in list do
			if a ~= b and mass[a] and mass[b] then
				local ra, rb = rootOf(a), rootOf(b)
				local sa, sb = scaleFor(mass[a]), scaleFor(mass[b])
				if ra and rb and sa >= sb * Config.PVP_RATIO and (ra.Position - rb.Position).Magnitude <= Config.EAT_RADIUS * Config.CHARACTER_HEIGHT * sa + 2 then
					local gain = (mass[b] - Config.START_MASS) * Config.PVP_STEAL + Config.START_MASS
					EatenEvent:FireClient(b, a.DisplayName)
					AteEvent:FireClient(a, b.DisplayName, gain, rb.Position, sb * Config.CHARACTER_HEIGHT)
					resetPlayer(b)
					b:LoadCharacter()
					addMass(a, gain)
				end
			end
		end
	end
end

local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc >= Config.EAT_TICK then
		acc = 0
		eatTick()
	end
end)

-- Rounds ------------------------------------------------------------------------------------

local function broadcast(phase: string, timeLeft: number, extra: { [string]: any }?)
	local msg: { [string]: any } = { phase = phase, timeLeft = timeLeft }
	if extra then
		for k, v in extra do
			msg[k] = v
		end
	end
	RoundEvent:FireAllClients(msg)
end

task.spawn(function()
	-- The first city is built straight away so there is something to look at during intermission.
	edibles = City.build()
	while true do
		roundActive = false
		for t = Config.INTERMISSION_SECONDS, 1, -1 do
			broadcast("Intermission", t)
			task.wait(1)
		end
		while #Players:GetPlayers() < Config.MIN_PLAYERS_TO_START do
			broadcast("Waiting", 0)
			task.wait(1)
		end
		edibles = City.build()
		for _, player in Players:GetPlayers() do
			player:LoadCharacter()
		end
		roundActive = true
		for t = Config.ROUND_SECONDS, 1, -1 do
			broadcast("Round", t)
			task.wait(1)
		end
		roundActive = false
		local best: Player? = nil
		for player, m in mass do
			if not best or m > (mass[best] or 0) then
				best = player
			end
		end
		if best then
			local ls = best:FindFirstChild("leaderstats")
			local wins = ls and ls:FindFirstChild("Wins") :: IntValue?
			if wins then
				wins.Value += 1
			end
		end
		broadcast("End", 0, { winner = if best then best.DisplayName else "", size = if best then math.floor(mass[best] or 0) else 0 })
		task.wait(5)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[--!strict
-- The web game's own models in Roblox. Each one was exported to GLB (tools/model-export), uploaded
-- as an asset (roblox/upload-assets.sh) and listed in Shared.AssetIds. Loading flattens the asset
-- into one Model, repaints every MeshPart from Shared.ModelInfo (the importer's colours are not
-- trusted) and puts the pivot at the bottom centre. Clones come out scaled so their largest
-- dimension is the requested size in studs. Callers fall back to primitives when this returns nil.

local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetIds = require(Shared:WaitForChild("AssetIds"))
local ModelInfo = require(Shared:WaitForChild("ModelInfo"))

local Models = {}

-- Material names used by Shared.ModelInfo (see tools/roblox-modelinfo.mjs).
local MATERIALS: { [string]: Enum.Material } = {}
for _, name in { "Neon", "Glass", "Metal", "CorrodedMetal", "Plastic", "SmoothPlastic", "Brick", "Concrete", "Limestone", "Pavement", "Asphalt", "Pebble", "Rubber", "WoodPlanks", "Wood", "Fabric", "Cardboard" } do
	MATERIALS[name] = (Enum.Material :: any)[name]
end

local store = Instance.new("Folder")
store.Name = "ModelTemplates"
store.Parent = ServerStorage

local templates: { [string]: Model } = {}
local loading: { [string]: boolean } = {}
local failed: { [string]: boolean } = {}

local function prepare(name: string, asset: Instance): Model?
	local info = ModelInfo[name]
	local model = Instance.new("Model")
	model.Name = name
	model.WorldPivot = CFrame.new()
	local count = 0
	for _, d in asset:GetDescendants() do
		if d:IsA("BasePart") then
			local mesh = info and info.meshes[d.Name]
			if mesh then
				d.Color = Color3.fromHex(mesh.c)
				d.Material = MATERIALS[mesh.m] or Enum.Material.SmoothPlastic
				d.Transparency = mesh.t
			end
			d.Anchored = true
			d.CanTouch = false
			d.Parent = model
			count += 1
		end
	end
	asset:Destroy()
	if count == 0 then
		model:Destroy()
		return nil
	end
	local box, size = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(box.X, box.Y - size.Y / 2, box.Z)
	model:SetAttribute("Box", size)
	model.Parent = store
	return model
end

-- Load (once) and return the template, or nil when the model has no asset id or failed to load.
-- Yields while LoadAsset runs; concurrent callers for the same name wait for the first one.
function Models.load(name: string): Model?
	while loading[name] do
		task.wait()
	end
	if templates[name] then
		return templates[name]
	end
	local id = AssetIds[name]
	if not id or failed[name] then
		return nil
	end
	loading[name] = true
	local ok, result = pcall(InsertService.LoadAsset, InsertService, id)
	local model = if ok then prepare(name, result :: Instance) else nil
	if model then
		templates[name] = model
	else
		failed[name] = true
		warn(string.format("Models: %s (%d) did not load: %s", name, id, if ok then "no parts" else tostring(result)))
	end
	loading[name] = nil
	return model
end

-- Load many models in parallel and wait for all of them.
function Models.preload(names: { string })
	local pending = 0
	for _, name in names do
		if AssetIds[name] and not templates[name] then
			pending += 1
			task.spawn(function()
				Models.load(name)
				pending -= 1
			end)
		end
	end
	while pending > 0 do
		task.wait()
	end
end

-- A fresh copy whose largest dimension is `size` studs, pivot at its bottom centre (not parented).
function Models.clone(name: string, size: number): Model?
	local template = Models.load(name)
	if not template then
		return nil
	end
	local box = template:GetAttribute("Box") :: Vector3
	local m = template:Clone()
	m:ScaleTo(size / math.max(box.X, box.Y, box.Z))
	return m
end

return Models
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox) HUD: round timer, your size, bite toasts and a pop effect.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local AteEvent = remotes:WaitForChild("Ate") :: RemoteEvent
local EatenEvent = remotes:WaitForChild("Eaten") :: RemoteEvent
local RoundEvent = remotes:WaitForChild("RoundState") :: RemoteEvent
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

-- Built-in engine sounds (rbxasset://), so no uploaded audio is needed.
local function sound(id: string, volume: number): Sound
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Parent = SoundService
	return s
end
local sndEat = sound("rbxasset://sounds/electronicpingshort.wav", 0.35)
local sndBig = sound("rbxasset://sounds/swoosh.wav", 0.6)
local sndEaten = sound("rbxasset://sounds/uuhhh.mp3", 0.7)

local gui = Instance.new("ScreenGui")
gui.Name = "GrowHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = player:WaitForChild("PlayerGui")

local function label(name: string, pos: UDim2, anchor: Vector2, size: UDim2, textSize: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.Position = pos
	l.AnchorPoint = anchor
	l.Size = size
	l.BackgroundTransparency = 0.35
	l.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold
	l.TextSize = textSize
	l.Text = ""
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = l
	l.Parent = gui
	return l
end

local status = label("Status", UDim2.new(0.5, 0, 0, 12), Vector2.new(0.5, 0), UDim2.fromOffset(320, 40), 22)
local sizeLabel = label("Size", UDim2.new(0, 16, 1, -16), Vector2.new(0, 1), UDim2.fromOffset(220, 48), 24)
local toast = label("Toast", UDim2.new(0.5, 0, 0.72, 0), Vector2.new(0.5, 0.5), UDim2.fromOffset(360, 44), 22)
toast.Visible = false

local function fmt(seconds: number): string
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function refreshSize()
	local m = player:GetAttribute("Mass") :: number? or 0
	sizeLabel.Text = string.format("Size %s", if m >= 1000 then string.format("%.1fk", m / 1000) else tostring(math.floor(m)))
end
player:GetAttributeChangedSignal("Mass"):Connect(refreshSize)
refreshSize()

local toastToken = 0
local function showToast(text: string, color: Color3?)
	toastToken += 1
	local mine = toastToken
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.Visible = true
	task.delay(1.6, function()
		if toastToken == mine then
			toast.Visible = false
		end
	end)
end

-- A quick expanding bubble where something was eaten (local only, purely visual).
local function pop(position: Vector3, size: number)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 210, 90)
	p.Transparency = 0.3
	local d = math.max(1, size)
	p.Size = Vector3.new(d, d, d) * 0.5
	p.Position = position
	p.Parent = workspace
	local t = TweenService:Create(p, TweenInfo.new(0.35), { Size = Vector3.new(d, d, d) * 1.4, Transparency = 1 })
	t:Play()
	t.Completed:Connect(function()
		p:Destroy()
	end)
end

AteEvent.OnClientEvent:Connect(function(kind: string, gain: number, position: Vector3, size: number)
	pop(position, size)
	local scale = player:GetAttribute("Scale") :: number? or 1
	-- Small bites ping higher, big bites lower; a bite near your own size gets the swoosh.
	if size >= Config.CHARACTER_HEIGHT * scale * 0.5 then
		sndBig:Play()
	else
		sndEat.PlaybackSpeed = math.clamp(1.6 - size / (Config.CHARACTER_HEIGHT * scale), 0.7, 1.6)
		sndEat:Play()
	end
	if size >= 4 then
		showToast(string.format("Ate %s! +%d", kind, math.floor(gain)), Color3.fromRGB(255, 220, 120))
	end
end)

EatenEvent.OnClientEvent:Connect(function(by: string)
	sndEaten:Play()
	showToast(string.format("%s ate you! Start small again", by), Color3.fromRGB(255, 120, 120))
end)

RoundEvent.OnClientEvent:Connect(function(msg: { [string]: any })
	local phase = msg.phase
	if phase == "Round" then
		status.Text = "Eat the city  " .. fmt(msg.timeLeft)
	elseif phase == "Intermission" then
		status.Text = "Next round in " .. tostring(msg.timeLeft)
	elseif phase == "Waiting" then
		status.Text = "Waiting for players…"
	elseif phase == "Landmark" then
		sndBig:Play()
		showToast(string.format("%s ATE THE %s!", tostring(msg.name), string.upper(tostring(msg.landmark or "landmark"))), Color3.fromRGB(255, 200, 60))
	elseif phase == "End" then
		status.Text = if msg.winner ~= "" then string.format("%s wins! (Size %d)", msg.winner, msg.size) else "Round over"
	end
end)

-- "Now you can eat: …" whenever growth unlocks the next kind of object (the goal is always visible).
local unlocks: { { name: string, size: number } } = {}
for _, k in Config.PROPS do
	table.insert(unlocks, { name = k.name, size = math.max(k.dims.X, k.dims.Y, k.dims.Z) })
end
for _, l in Config.LANDMARKS do
	table.insert(unlocks, { name = l.name, size = l.size })
end
table.sort(unlocks, function(a, b)
	return a.size < b.size
end)
local announced = 0
local function checkUnlocks()
	local scale = player:GetAttribute("Scale") :: number? or 1
	local reach = Config.EAT_REACH * Config.CHARACTER_HEIGHT * scale
	local newest: string? = nil
	for idx, u in unlocks do
		if u.size <= reach then
			if idx > announced then
				newest = u.name
				announced = idx
			end
		end
	end
	-- Everything edible at spawn is not news; only announce growth past the start.
	if newest and scale > 1.01 then
		sndBig:Play()
		showToast("Now you can eat: " .. newest .. "!", Color3.fromRGB(140, 230, 255))
	end
end
player:GetAttributeChangedSignal("Scale"):Connect(checkUnlocks)

-- Field of view widens a little as the machine grows, like the web game's camera rig.
local function applyFov()
	local scale = player:GetAttribute("Scale") :: number? or 1
	local size = Config.MACHINE_SIZE * scale
	workspace.CurrentCamera.FieldOfView = math.min(Config.CAMERA_FOV_MAX, Config.CAMERA_FOV_BASE + Config.CAMERA_FOV_PER_SIZE * size)
end
player:GetAttributeChangedSignal("Scale"):Connect(applyFov)
applyFov()
-- Respawning or a new round starts small again: re-arm the announcements.
player:GetAttributeChangedSignal("Mass"):Connect(function()
	local m = player:GetAttribute("Mass") :: number? or 0
	if m <= Config.START_MASS + 0.001 then
		announced = 0
		local reach = Config.EAT_REACH * Config.CHARACTER_HEIGHT
		for idx, u in unlocks do
			if u.size <= reach then
				announced = idx
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>