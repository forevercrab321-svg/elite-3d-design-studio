  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Bot</string>
          <string name="Source"><![CDATA[--!strict
-- AI rival, ported from the web arena (arena/ArenaBot.ts). Priorities, re-evaluated every few
-- hundred ms: 1. flee a machine that can eat it, 2. hunt a machine it can eat when one is close,
-- 3. otherwise collect the best nearby object (golden crates and power-ups favoured, squared
-- distance against diminishing reward). Skill (0..1) softens rookie rounds: slower decisions, a
-- shorter hunt radius, rarer dashes and no hunting humans during a grace period.
-- Output: a world direction (metres) and whether to dash, like the player's camera-mapped input.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WebConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WebConfig"))

local A = WebConfig.arena

-- What the bot needs from the round (Main builds it).
export type Game = {
	time: number,
	matchTime: number,
	skill: number,
	actors: { any },
	objects: { any },
	canEat: (any, any) -> boolean,
	spares: (any, any) -> boolean,
	eligible: (any, number) -> boolean,
	reward: (any) -> number,
	isBlocked: (number, number, number, number, any) -> boolean,
}

local Bot = {}
Bot.__index = Bot

export type Bot = typeof(setmetatable({} :: {
	target: any,
	prey: any,
	threat: any,
	thinkAt: number,
	checkAt: number,
	lastDist: number,
	blacklist: { [number]: number },
	wanderUntil: number,
	wx: number,
	wz: number,
	nextDash: number,
	huntStart: number,
	spared: { [string]: number },
	rand: Random,
}, Bot))

function Bot.new(seed: number): Bot
	return setmetatable({
		target = nil,
		prey = nil,
		threat = nil,
		thinkAt = 0,
		checkAt = 0,
		lastDist = math.huge,
		blacklist = {},
		wanderUntil = 0,
		wx = 0,
		wz = -1,
		nextDash = 0,
		huntStart = 0,
		spared = {},
		rand = Random.new(seed),
	}, Bot)
end

local function hypot(x: number, z: number): number
	return math.sqrt(x * x + z * z)
end

function Bot.think(self: Bot, g: Game, me: any)
	local skill = math.clamp(g.skill, 0, 1)
	self.thinkAt = g.time + (0.25 + self.rand:NextNumber() * 0.15) * (1 + (1 - skill) * A.botThinkSlow)
	local huntRange = A.botHuntRangeRookie + (1 - A.botHuntRangeRookie) * skill
	local graceOver = g.matchTime >= A.botHumanGraceSeconds * (1 - skill)
	local prevPrey = self.prey
	self.threat = nil
	self.prey = nil
	local bestThreat, bestPrey = math.huge, math.huge
	for _, o in g.actors do
		if o ~= me and o.alive then
			local d = hypot(o.body.x - me.body.x, o.body.z - me.body.z)
			if g.canEat(o, me) and d < 10 + o.diameter * 3 and d < bestThreat then
				bestThreat = d
				self.threat = o
			elseif
				g.canEat(me, o)
				and d < (22 + me.diameter * 3) * huntRange
				and (o.kind == "bot" or graceOver)
				and d < bestPrey
				and (o.mass >= me.mass * A.botPreyMinShare or d < me.diameter)
				and not g.spares(me, o)
				and (self.spared[o.id] or 0) <= g.time
			then
				bestPrey = d
				self.prey = o
			end
		end
	end
	if self.prey ~= prevPrey then
		self.huntStart = g.time
	elseif self.prey and g.time - self.huntStart > A.botHuntGiveUp then
		self.spared[self.prey.id] = g.time + A.botHuntGiveUp
		self.prey = nil
	end
	if self.target and not g.eligible(self.target, me.diameter) then
		self.target = nil
	end
	if not self.target then
		local best, bestScore = nil, math.huge
		for _, o in g.objects do
			if g.eligible(o, me.diameter) and (self.blacklist[o.id] or 0) <= g.time then
				local d = hypot(o.x - me.body.x, o.z - me.body.z)
				-- Worth the trip: diminishing reward, golden crates ×2, power-ups ×6, own class ×1.4.
				local value = math.sqrt(math.max(0.05, g.reward(o))) * (if o.def.bonus then 2 elseif o.def.power then 6 else 1) * (if o.def.objectClass == me.cls then 1.4 else 1)
				local score = (d + 1.5) * (d + 1.5) / value
				if score < bestScore then
					bestScore = score
					best = o
				end
			end
		end
		self.target = best
		self.lastDist = math.huge
		self.checkAt = g.time + 0.8
	end
end

function Bot.avoid(self: Bot, g: Game, me: any, dx: number, dz: number): (number, number)
	local r = me.diameter * 0.5
	local ahead = me.diameter * 0.9 + 0.4
	for _, deg in { 0, 30, -30, 60, -60, 90, -90, 120, -120 } do
		local a = math.rad(deg)
		local cx = dx * math.cos(a) - dz * math.sin(a)
		local cz = dx * math.sin(a) + dz * math.cos(a)
		if not g.isBlocked(me.body.x + cx * ahead, me.body.z + cz * ahead, r, me.diameter, self.target) then
			return cx, cz
		end
	end
	return dx, dz
end

function Bot.intents(self: Bot, g: Game, me: any): (number, number, boolean)
	local t = g.time
	if t >= self.thinkAt then
		self:think(g, me)
	end
	local dx, dz, dash = 0, -1, false
	if t < self.wanderUntil then
		dx, dz = self.wx, self.wz
	elseif self.threat then
		dx = me.body.x - self.threat.body.x
		dz = me.body.z - self.threat.body.z
		dash = t > self.nextDash
	elseif self.prey then
		dx = self.prey.body.x - me.body.x
		dz = self.prey.body.z - me.body.z
		dash = hypot(dx, dz) < 6 + me.diameter * 2 and t > self.nextDash
	elseif self.target then
		dx = self.target.x - me.body.x
		dz = self.target.z - me.body.z
		local dist = hypot(dx, dz)
		if t >= self.checkAt then
			-- Stuck (not getting closer): blacklist the target for 6 s and sidestep.
			if self.lastDist ~= math.huge and self.lastDist - dist < 0.08 * math.max(1, me.diameter) then
				self.blacklist[self.target.id] = t + 6
				self.target = nil
				local side = if self.rand:NextNumber() < 0.5 then 1 else -1
				self.wx = (-dz / math.max(dist, 1e-3)) * side
				self.wz = (dx / math.max(dist, 1e-3)) * side
				self.wanderUntil = t + 0.7
			end
			self.lastDist = dist
			self.checkAt = t + 0.8
		end
		dash = dist > 4 + me.diameter * 3 and t > self.nextDash
	end
	if dash then
		self.nextDash = t + (2.2 + self.rand:NextNumber() * 1.5) * (1 + (1 - g.skill) * A.botThinkSlow)
	end
	local len = hypot(dx, dz)
	if len < 1e-6 then
		len = 1
	end
	dx, dz = self:avoid(g, me, dx / len, dz / len)
	return dx, dz, dash
end

return Bot
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox) server: the web arena's rules on the web cities.
-- Actors are players and AI rivals alike (AI fills the room to arena.maxPlayers). Each machine is
-- a Model in workspace.Machines with an invisible Root ball: a player's client drives its own
-- (Play.client, network-owned), the server drives the AI (Bot + shared Movement). The server owns
-- the rules: claims checked here, objects pulled in with the web formula, mass with combo and
-- catch-up, lives and respawns, machines eating machines, landmark lock and bonus, round end.
-- Root attributes: ActorId, Look, Slot, Name, IsBot, Diameter (m), Mass (kg), Lives,
-- InvulnerableUntil, SpeedUntil, MagnetUntil, ShieldUntil (server time).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local WebConfig = require(Shared:WaitForChild("WebConfig"))
local Growth = require(Shared:WaitForChild("Growth"))
local Collision = require(Shared:WaitForChild("Collision"))
local Movement = require(Shared:WaitForChild("Movement"))
local World = require(script.Parent:WaitForChild("World"))
local Models = require(script.Parent:WaitForChild("Models"))
local Bot = require(script.Parent:WaitForChild("Bot"))

local K = Config.STUDS_PER_METER
local A = WebConfig.arena
local G = WebConfig.growth
local CC = WebConfig.collection
local BOT_NAMES = { "Rustbucket", "Magna", "Gearjaw", "Scrapper", "Hoover-9", "Chomp" }

-- Remotes ------------------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in Config.REMOTES do
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotes
end
remotes.Parent = ReplicatedStorage
local ClaimEvent = remotes:WaitForChild("Claim") :: RemoteEvent
local CrashEvent = remotes:WaitForChild("Crash") :: RemoteEvent
local AbsorbedEvent = remotes:WaitForChild("Absorbed") :: RemoteEvent
local RoundEvent = remotes:WaitForChild("RoundState") :: RemoteEvent
local NoticeEvent = remotes:WaitForChild("Notice") :: RemoteEvent
local PickVehicleEvent = remotes:WaitForChild("PickVehicle") :: RemoteEvent

local machinesFolder = Instance.new("Folder")
machinesFolder.Name = "Machines"
machinesFolder.Parent = workspace

-- Actors ---------------------------------------------------------------------------------------
type Actor = {
	id: string,
	kind: string, -- "player" | "bot"
	player: Player?,
	name: string,
	slot: number,
	look: string,
	vehicle: any,
	mass: number,
	diameter: number,
	body: Movement.Body,
	model: Model?,
	root: BasePart?,
	alive: boolean,
	lives: number,
	eliminatedAt: number,
	invulnerableUntil: number,
	combo: number,
	comboAt: number,
	objects: number,
	kills: number,
	deaths: number,
	cls: number,
	tier: number,
	speedUntil: number,
	magnetUntil: number,
	shieldUntil: number,
	bot: any,
	eatCooldown: { [string]: number },
}
local actors: { Actor } = {}
local byPlayer: { [Player]: Actor } = {}
local joined = 0
local phase = "Loading"
local roundStart = 0
local landmarkOpen = false
local climaxTotal = 0
local climaxEaten = 0
local firstBlood = false
local roundsPlayed = 0

local function now(): number
	return workspace:GetServerTimeNow()
end
local function matchTime(): number
	return if phase == "Round" then os.clock() - roundStart else 0
end

local function notice(a: Actor, msg: { [string]: any })
	if a.player then
		NoticeEvent:FireClient(a.player, msg)
	end
end
local function feed(text: string, tone: string?)
	NoticeEvent:FireAllClients({ kind = "feed", text = text, tone = tone or "info" })
end

local function sync(a: Actor)
	if a.player then
		local ls = a.player:FindFirstChild("leaderstats")
		local mass = ls and ls:FindFirstChild("Mass") :: IntValue?
		if mass then
			mass.Value = math.floor(a.mass)
		end
		a.player:SetAttribute("Mass", a.mass)
		a.player:SetAttribute("Diameter", a.diameter)
		a.player:SetAttribute("Lives", a.lives)
	end
	local root = a.root
	if root then
		root:SetAttribute("Mass", a.mass)
		root:SetAttribute("Diameter", a.diameter)
		root:SetAttribute("Lives", a.lives)
		root:SetAttribute("SpeedUntil", a.speedUntil)
		root:SetAttribute("MagnetUntil", a.magnetUntil)
		root:SetAttribute("ShieldUntil", a.shieldUntil)
		root.Size = Vector3.one * math.max(0.05, a.diameter * K)
	end
end

-- Set mass; tell a player when growth unlocks a class or a tier (ArenaGame announcements).
local function setMass(a: Actor, mass: number, quiet: boolean?)
	a.mass = math.max(G.startMass, mass)
	a.diameter = Growth.diameterForMass(a.mass)
	local cls = Growth.classForPower(a.diameter)
	local tier = Growth.tierForClass(cls)
	if not quiet and cls > a.cls then
		if tier > a.tier then
			notice(a, { kind = "tier", tier = tier, cls = cls })
		else
			notice(a, { kind = "unlock", cls = cls })
		end
	end
	a.cls = cls
	a.tier = tier
	sync(a)
end

-- Where a machine is: a player's from its (client-driven) root, an AI's from its body.
local function position(a: Actor): (number, number, number, number)
	local root = a.root
	if a.kind == "player" and root then
		local p = root.Position / K
		local look = root.CFrame.LookVector
		a.body.x, a.body.z = p.X, p.Z
		a.body.heading = math.atan2(-look.X, -look.Z)
	end
	return a.body.x, World.ground(a.body.x, a.body.z), a.body.z, a.body.heading
end

-- (Re)create a machine at a spawn point.
local function spawnMachine(a: Actor, x: number, z: number, heading: number)
	if a.model then
		a.model:Destroy()
	end
	a.body = Movement.new(x, z, heading)
	local d = a.diameter
	local m = Instance.new("Model")
	m.Name = a.id
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.one * d * K
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new(x * K, (World.ground(x, z) + d / 2) * K, z * K) * CFrame.Angles(0, heading, 0)
	local att = Instance.new("Attachment")
	att.Parent = root
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = true
	ap.Position = root.Position
	ap.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.CFrame = root.CFrame.Rotation
	ao.Parent = root
	root:SetAttribute("ActorId", a.id)
	root:SetAttribute("UserId", if a.player then a.player.UserId else 0)
	root:SetAttribute("Look", a.look)
	root:SetAttribute("Slot", a.slot)
	root:SetAttribute("Name", a.name)
	root:SetAttribute("IsBot", a.kind == "bot")
	root.Parent = m
	m.PrimaryPart = root
	m.Parent = machinesFolder
	if a.player then
		root:SetNetworkOwner(a.player)
	end
	a.model = m
	a.root = root
	a.alive = true
	a.invulnerableUntil = now() + A.invulnerableSeconds
	root:SetAttribute("InvulnerableUntil", a.invulnerableUntil)
	sync(a)
end

local function slotSpawn(a: Actor): (number, number, number)
	local spawns = World.city.spawns
	local sp = spawns[(a.slot - 1) % #spawns + 1]
	return sp.x, sp.z, sp.heading
end

-- Respawn at the spawn farthest from the biggest rival (ArenaGame.respawn).
local function farSpawn(a: Actor): (number, number, number)
	local threat: Actor? = nil
	for _, b in actors do
		if b ~= a and b.alive and (not threat or b.mass > threat.mass) then
			threat = b
		end
	end
	if not threat then
		return slotSpawn(a)
	end
	local best, bestD = nil, -1
	for _, sp in World.city.spawns do
		local d = math.sqrt((sp.x - threat.body.x) ^ 2 + (sp.z - threat.body.z) ^ 2)
		if d > bestD then
			best, bestD = sp, d
		end
	end
	return best.x, best.z, best.heading
end

local function newActor(kind: string, player: Player?, name: string, slot: number, look: string): Actor
	local a: Actor = {
		id = if player then tostring(player.UserId) else ("bot" .. slot),
		kind = kind,
		player = player,
		name = name,
		slot = slot,
		look = look,
		vehicle = WebConfig.vehicles[look],
		mass = G.startMass,
		diameter = G.startDiameter,
		body = Movement.new(0, 0, 0),
		model = nil,
		root = nil,
		alive = false,
		lives = A.lives,
		eliminatedAt = 0,
		invulnerableUntil = 0,
		combo = 0,
		comboAt = 0,
		objects = 0,
		kills = 0,
		deaths = 0,
		cls = 0,
		tier = 1,
		speedUntil = 0,
		magnetUntil = 0,
		shieldUntil = 0,
		bot = nil,
		eatCooldown = {},
	}
	return a
end

local function resetForRound(a: Actor, mass: number)
	a.combo, a.comboAt, a.objects, a.kills, a.deaths = 0, 0, 0, 0, 0
	a.speedUntil, a.magnetUntil, a.shieldUntil = 0, 0, 0
	a.lives, a.eliminatedAt = A.lives, 0
	a.cls, a.tier = 0, 1
	a.eatCooldown = {}
	setMass(a, mass, true)
	local x, z, h = slotSpawn(a)
	spawnMachine(a, x, z, h)
end

local function removeActor(a: Actor)
	if a.model then
		a.model:Destroy()
	end
	local i = table.find(actors, a)
	if i then
		table.remove(actors, i)
	end
end

local function medianMass(): number
	local list = {}
	for _, a in actors do
		if a.alive then
			table.insert(list, a.mass)
		end
	end
	table.sort(list)
	return if #list > 0 then list[math.ceil(#list / 2)] else G.startMass
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local mass = Instance.new("IntValue")
	mass.Name = "Mass"
	mass.Parent = ls
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = ls
	ls.Parent = player
	joined += 1
	local look = Config.MACHINE_LOOKS[(joined - 1) % #Config.MACHINE_LOOKS + 1]
	-- Take a free seat: replace an AI rival if the room is full of them (web drop-in).
	local slot = #actors + 1
	for _, b in actors do
		if b.kind == "bot" then
			slot = b.slot
			removeActor(b)
			break
		end
	end
	local a = newActor("player", player, player.DisplayName, slot, look)
	player:SetAttribute("ActorId", a.id)
	player:SetAttribute("Look", look)
	table.insert(actors, a)
	byPlayer[player] = a
	if World.city then
		if phase == "Round" and matchTime() > Config.ROUND_SECONDS - A.dropInCutoffSeconds then
			a.alive = false -- too late to drop in: watch, play the next round
		else
			resetForRound(a, if phase == "Round" then math.max(G.startMass, medianMass() * A.dropInMassShare) else G.startMass)
			if phase == "Round" then
				feed(a.name .. " joined the match")
			end
		end
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
-- Anyone who joined before this script got here (Studio Play joins immediately).
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player: Player)
	local a = byPlayer[player]
	if a then
		removeActor(a)
		byPlayer[player] = nil
		if phase == "Round" then
			feed(a.name .. " left the match")
		end
	end
end)

-- Rules ------------------------------------------------------------------------------------------

local function canEat(a: Actor, b: Actor): boolean
	local t = now()
	if a == b or not a.alive or not b.alive or t < b.invulnerableUntil or t < a.invulnerableUntil or t < b.shieldUntil then
		return false
	end
	return a.diameter >= b.diameter * A.eatRatio * a.vehicle.eatRatio
end

local function botSkill(): number
	return math.clamp(A.botSkillRookie + (1 - A.botSkillRookie) * roundsPlayed / A.botSkillRounds, 0, 1)
end

-- Training wheels: a rookie AI spares a human worth less than (1 − skill) × 40% of its mass.
local function spares(a: Actor, b: Actor): boolean
	return a.kind == "bot" and b.kind ~= "bot" and b.mass < a.mass * (1 - botSkill()) * A.botRookieHumanPreyShare
end

local function eligible(o: World.Obj, power: number): boolean
	return World.eligible(o, power, landmarkOpen)
end

-- Object gain multiplier: catch-up when behind the leader, drag when far ahead (ArenaGame.catchUp).
local function catchUp(a: Actor): number
	local lead = 0
	for _, b in actors do
		if b.alive and b ~= a then
			lead = math.max(lead, b.mass)
		end
	end
	if lead <= 0 then
		return 1
	end
	if lead > a.mass then
		return 1 + A.catchUpMax * math.min(1, math.log(lead / a.mass) / math.log(A.catchUpFullRatio))
	end
	local ahead = a.mass / (lead * A.leaderDragFrom)
	return if ahead <= 1 then 1 else math.max(A.leaderDragMin, (1 / ahead) ^ A.leaderDragExp)
end

local function reach(a: Actor): number
	local magnet = if now() < a.magnetUntil then A.magnetMul else 1
	return (a.diameter / 2 + a.diameter * CC.reachFactor + CC.reachFlat) * a.vehicle.reach * magnet
end

-- Claim every eligible object in reach for this actor (checked against the server's state).
local function tryClaim(a: Actor, ids: { number }?, slack: number)
	local x, _, z = position(a)
	local r = reach(a) * slack
	local list: { World.Obj } = {}
	if ids then
		for i, id in ids do
			if i > 64 then
				break
			end
			local o = typeof(id) == "number" and World.objects[id] or nil
			if o then
				table.insert(list, o)
			end
		end
	else
		list = World.near(x, z, r * CC.vacuumReachMultiplier)
	end
	for _, o in list do
		if eligible(o, a.diameter) then
			local rr = if o.radius * 2 < a.diameter * CC.vacuumSizeRatio then r * CC.vacuumReachMultiplier else r
			if Collision.circleVsObb(x, z, rr, World.box(o)) then
				World.startPull(o, a)
			end
		end
	end
end

ClaimEvent.OnServerEvent:Connect(function(player: Player, ids: any)
	local a = byPlayer[player]
	if phase ~= "Round" or not a or not a.alive or typeof(ids) ~= "table" then
		return
	end
	tryClaim(a, ids, Config.CLAIM_SLACK)
end)

-- Lobby: pick one of the four web vehicles (between rounds only; it changes stats, not just looks).
PickVehicleEvent.OnServerEvent:Connect(function(player: Player, look: any)
	local a = byPlayer[player]
	if not a or typeof(look) ~= "string" or not WebConfig.vehicles[look] or not table.find(Config.MACHINE_LOOKS, look) then
		return
	end
	if phase ~= "Intermission" and phase ~= "Waiting" and phase ~= "Loading" then
		return
	end
	a.look = look
	a.vehicle = WebConfig.vehicles[look]
	player:SetAttribute("Look", look)
	if a.root then
		a.root:SetAttribute("Look", look)
	end
end)

-- A player's client reports dashing into something too big: the web penalty (3% of mass).
local function crash(a: Actor)
	local lost = math.max(0, (a.mass - G.startMass) * A.crashMassLoss)
	setMass(a, a.mass - lost, true)
	local v, u = Growth.massText(lost)
	notice(a, { kind = "crash", text = "CRASH · −" .. v .. " " .. string.upper(u) })
end
CrashEvent.OnServerEvent:Connect(function(player: Player)
	local a = byPlayer[player]
	if a and a.alive and phase == "Round" then
		crash(a)
	end
end)

local function absorb(a: Actor, o: World.Obj)
	local def = o.def
	local t = now()
	a.combo = if t - a.comboAt <= A.comboWindow then a.combo + 1 else 1
	a.comboAt = t
	local mult = math.min(A.comboMax, 1 + A.comboStep * (a.combo - 1))
	if def.power == "speed" then
		a.speedUntil = t + A.speedSeconds
	elseif def.power == "magnet" then
		a.magnetUntil = t + A.magnetSeconds
	elseif def.power == "shield" then
		a.shieldUntil = t + A.shieldSeconds
	end
	local gain = if def.bonus then math.max(def.rewardMass, a.mass * A.goldCrateShare) else def.rewardMass
	gain *= mult * catchUp(a)
	a.objects += 1
	local ox, oy, oz = o.x, o.y, o.z
	World.remove(o)
	local lastClimax = false
	if def.climax then
		climaxEaten += 1
		workspace:SetAttribute("ClimaxEaten", climaxEaten)
		if climaxEaten >= climaxTotal then
			lastClimax = true
			gain += a.mass * A.landmarkBonus
		end
	end
	setMass(a, a.mass + gain)
	if a.player then
		AbsorbedEvent:FireClient(a.player, {
			label = def.label,
			gain = gain,
			combo = if a.combo >= 2 then mult else nil,
			catchUp = catchUp(a),
			cls = def.objectClass,
			power = def.power,
			bonus = def.bonus,
			position = Vector3.new(ox, oy + def.size[2] / 2, oz) * K,
			size = math.max(def.size[1], def.size[2], def.size[3]),
		})
	end
	if def.bonus then
		local v, u = Growth.massText(gain)
		notice(a, { kind = "feed", text = "Golden crate +" .. v .. " " .. u, tone = "bonus" })
	end
	if lastClimax then
		NoticeEvent:FireAllClients({ kind = "landmarkDown", name = a.name, city = World.city.id })
		feed(a.name .. " ate the last piece of the landmark", "bonus")
	end
end

-- Machines eating machines (ArenaGame.proposeEats / applyEaten).
local function eatActor(a: Actor, b: Actor)
	local first = not firstBlood
	firstBlood = true
	local leader = true
	for _, c in actors do
		if c ~= b and c.alive and c.mass > b.mass then
			leader = false
		end
	end
	local gain = b.mass * A.eatGain * (if first then 1 + A.firstBloodBonus else 1) * (if leader then 1 + A.leaderBounty else 1)
	a.kills += 1
	b.deaths += 1
	b.lives = math.max(0, b.lives - 1)
	b.alive = false
	if b.model then
		b.model:Destroy()
		b.model = nil
		b.root = nil
	end
	setMass(a, a.mass + gain)
	local v, u = Growth.massText(gain)
	notice(a, { kind = "ate", name = b.name, gain = gain, first = first })
	notice(b, { kind = "eaten", name = a.name, lives = b.lives })
	feed(string.format("%s ate %s · +%s %s", a.name, b.name, v, u), "kill")
	local keep = math.max(G.startMass, b.mass * A.respawnMassKeep)
	if b.lives <= 0 then
		b.eliminatedAt = os.clock()
		feed(b.name .. " is out", "bad")
		return
	end
	task.delay(A.respawnDelay, function()
		if table.find(actors, b) and phase == "Round" and not b.alive then
			setMass(b, keep, true)
			local x, z, h = farSpawn(b)
			spawnMachine(b, x, z, h)
			notice(b, { kind = "respawn" })
		end
	end)
end

local function pvp()
	local t = os.clock()
	for _, a in actors do
		for _, b in actors do
			if canEat(a, b) and not spares(a, b) and (a.eatCooldown[b.id] or 0) <= t then
				local ax, _, az = position(a)
				local bx, _, bz = position(b)
				if math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2) <= (a.diameter / 2) * A.eatReach + b.diameter * 0.2 then
					a.eatCooldown[b.id] = t + 0.6
					eatActor(a, b)
				end
			end
		end
	end
end

-- AI rivals -------------------------------------------------------------------------------------
local function solidsNear(x: number, z: number, r: number, power: number, ignore: any): { Movement.Solid }
	local out: { Movement.Solid } = {}
	for _, o in World.near(x, z, r) do
		if o ~= ignore and World.solid(o, power, landmarkOpen) then
			table.insert(out, { x = o.x, z = o.z, radius = o.radius, box = World.box(o) })
		end
	end
	return out
end

local botGame = {
	time = 0,
	matchTime = 0,
	skill = 0.3,
	actors = actors,
	objects = World.objects,
	canEat = canEat,
	spares = spares,
	eligible = eligible,
	reward = function(o: any): number
		return o.def.rewardMass
	end,
	isBlocked = function(x: number, z: number, r: number, power: number, ignore: any): boolean
		return Movement.blocked(x, z, r, World.colliders, World.city.bounds, solidsNear(x, z, r, power, ignore))
	end,
}

-- Bumper cars for AI machines (players push themselves on their clients).
local function bumpBots()
	for _, a in actors do
		if a.kind == "bot" and a.alive then
			for _, b in actors do
				if b ~= a and b.alive and not ((canEat(a, b) and not spares(a, b)) or (canEat(b, a) and not spares(b, a))) then
					local bx, _, bz = position(b)
					Movement.bump(a.body, a.diameter, bx, bz, b.diameter, math.abs(b.body.speed), if b.kind == "bot" then 0.5 else 1)
				end
			end
		end
	end
end

local function stepBots(dt: number)
	botGame.time = os.clock()
	botGame.matchTime = matchTime()
	botGame.skill = botSkill()
	botGame.objects = World.objects
	local frozen = phase ~= "Round"
	for _, a in actors do
		if a.kind == "bot" and a.alive and a.root then
			local dx, dz, dash = 0, 0, false
			if not frozen then
				dx, dz, dash = a.bot:intents(botGame, a)
			end
			local solids = solidsNear(a.body.x, a.body.z, a.diameter + 1, a.diameter, nil)
			local _, crashed = Movement.step(a.body, dt, now(), dx, dz, dash, frozen, a.mass, a.diameter, a.vehicle, now() < a.speedUntil, World.colliders, World.city.bounds, solids)
			if crashed then
				crash(a)
			end
			local root = a.root :: BasePart
			local ap = root:FindFirstChildOfClass("AlignPosition")
			local ao = root:FindFirstChildOfClass("AlignOrientation")
			local y = World.ground(a.body.x, a.body.z) + a.diameter / 2
			if ap and ao then
				ap.Position = Vector3.new(a.body.x, y, a.body.z) * K
				ao.CFrame = CFrame.Angles(0, a.body.heading, 0)
			end
			if not frozen then
				tryClaim(a, nil, 1)
			end
		end
	end
end

local function fillWithBots()
	local names = table.clone(BOT_NAMES)
	local used: { [number]: boolean } = {}
	for _, a in actors do
		used[a.slot] = true
	end
	for slot = 1, A.maxPlayers do
		if not used[slot] and #actors < A.maxPlayers then
			local name = table.remove(names, math.random(1, #names)) :: string
			local look = Config.MACHINE_LOOKS[slot % #Config.MACHINE_LOOKS + 1]
			local a = newActor("bot", nil, name, slot, look)
			a.bot = Bot.new(slot * 7919 + roundsPlayed)
			table.insert(actors, a)
		end
	end
end

-- Simulation tick ------------------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt: number)
	dt = math.min(dt, 0.1)
	World.stepFalling(dt)
	for _, o in World.objects do
		if o.state == "pulled" then
			local a = o.owner :: Actor?
			if not a or not a.alive or not table.find(actors, a) then
				-- Owner gone: drop back to idle where it is.
				o.state = "idle"
				o.y = World.ground(o.x, o.z)
				o.tilt = 0
				if o.model then
					o.model:SetAttribute("State", "idle")
				end
			else
				local x, y, z, heading = position(a)
				if World.stepPull(o, dt, x, z, y, heading, a.diameter, a.vehicle.pull) then
					absorb(a, o)
				end
			end
		end
	end
	stepBots(dt)
	if phase == "Round" then
		bumpBots()
		pvp()
	end
end)

-- Rounds -----------------------------------------------------------------------------------

local function leaderboard(): { any }
	local rows = {}
	for _, a in actors do
		table.insert(rows, { id = a.id, name = a.name, mass = a.mass, lives = a.lives, slot = a.slot, alive = a.alive or a.lives > 0, objects = a.objects, kills = a.kills, deaths = a.deaths, bot = a.kind == "bot", userId = if a.player then a.player.UserId else 0, eliminatedAt = a.eliminatedAt, look = a.look })
	end
	-- Survivors first by mass; then eliminated (later elimination ranks higher).
	table.sort(rows, function(x, y)
		if x.alive ~= y.alive then
			return x.alive
		end
		if x.alive then
			return x.mass > y.mass
		end
		return x.eliminatedAt > y.eliminatedAt
	end)
	return rows
end

local function broadcast(msg: { [string]: any })
	msg.city = World.city and World.city.id
	msg.climaxEaten = climaxEaten
	msg.climaxTotal = climaxTotal
	msg.board = leaderboard()
	RoundEvent:FireAllClients(msg)
	workspace:SetAttribute("Phase", msg.phase)
end

-- Joke awards on the results card (arena/comedy.ts).
local function awards(rows: { any }): { string }
	local out = {}
	local function top(key: string): any
		local best = nil
		for _, r in rows do
			if not best or r[key] > best[key] then
				best = r
			end
		end
		return best
	end
	local glutton = top("objects")
	if glutton and glutton.objects > 0 then
		table.insert(out, string.format("🍔 Bottomless Pit — %s (%d things eaten)", glutton.name, glutton.objects))
	end
	local shark = top("kills")
	if shark and shark.kills > 0 then
		table.insert(out, string.format("🦈 City Shark — %s (%d rivals eaten)", shark.name, shark.kills))
	end
	local food = top("deaths")
	if food and food.deaths > 0 then
		table.insert(out, string.format("🥡 Takeaway Delivery — %s (eaten %d×)", food.name, food.deaths))
	end
	if #rows > 2 then
		local chill = nil
		for i, r in rows do
			if i > 1 and (not chill or r.mass < chill.mass) then
				chill = r
			end
		end
		if chill then
			table.insert(out, string.format("🐢 Zen Mode — %s (it's the taking part that counts)", chill.name))
		end
	end
	return out
end

local function roundOver(): boolean
	local alive, humans, humansAlive = 0, 0, 0
	for _, a in actors do
		local inGame = a.alive or a.lives > 0
		if inGame then
			alive += 1
		end
		if a.kind == "player" then
			humans += 1
			if inGame then
				humansAlive += 1
			end
		end
	end
	if #actors >= 2 and alive <= 1 then
		return true
	end
	if humans > 0 and humansAlive == 0 then
		return true
	end
	return climaxTotal > 0 and climaxEaten >= climaxTotal
end

-- Machine models for every look and tier (clients clone them from ReplicatedStorage).
task.spawn(function()
	local names = {}
	for _, look in Config.MACHINE_LOOKS do
		for tier = 1, 5 do
			table.insert(names, string.format("Machine_%s_T%d", look, tier))
		end
	end
	Models.preload(names)
end)

task.spawn(function()
	local cityIndex = 0
	while true do
		cityIndex = cityIndex % #Config.CITIES + 1
		local cityId = Config.CITIES[cityIndex]
		phase = "Loading"
		workspace:SetAttribute("Phase", phase)
		landmarkOpen = false
		workspace:SetAttribute("LandmarkOpen", false)
		World.build(cityId)
		botGame.objects = World.objects
		climaxTotal, climaxEaten, firstBlood = 0, 0, false
		for _, o in World.objects do
			if o.def.climax then
				climaxTotal += 1
			end
		end
		workspace:SetAttribute("ClimaxEaten", 0)
		workspace:SetAttribute("ClimaxTotal", climaxTotal)
		for i = #actors, 1, -1 do
			if actors[i].kind == "bot" then
				removeActor(actors[i])
			end
		end
		for _, a in actors do
			resetForRound(a, G.startMass)
		end
		-- Lobby: drive around the new city; nothing can be eaten yet.
		phase = "Intermission"
		for t = Config.INTERMISSION_SECONDS, 1, -1 do
			broadcast({ phase = phase, timeLeft = t })
			task.wait(1)
		end
		while #Players:GetPlayers() < Config.MIN_PLAYERS_TO_START do
			broadcast({ phase = "Waiting", timeLeft = 0 })
			task.wait(1)
		end
		fillWithBots()
		for _, a in actors do
			resetForRound(a, G.startMass)
		end
		phase = "Countdown"
		for t = Config.COUNTDOWN_SECONDS, 1, -1 do
			broadcast({ phase = phase, timeLeft = t })
			task.wait(1)
		end
		phase = "Round"
		roundStart = os.clock()
		broadcast({ phase = phase, timeLeft = Config.ROUND_SECONDS, go = true })
		local refillClock = 0
		while true do
			task.wait(1)
			refillClock += 1
			if refillClock >= A.refillCheckSeconds then
				refillClock = 0
				local machines = {}
				for _, a in actors do
					if a.alive then
						local x, _, z = position(a)
						table.insert(machines, { x, z, a.diameter })
					end
				end
				World.refill(machines)
			end
			local elapsed = os.clock() - roundStart
			local left = math.max(0, math.ceil(Config.ROUND_SECONDS - elapsed))
			if not landmarkOpen and elapsed >= A.landmarkOpenSeconds then
				landmarkOpen = true
				workspace:SetAttribute("LandmarkOpen", true)
				NoticeEvent:FireAllClients({ kind = "landmarkOpen", city = cityId })
				feed("The landmark is open · topple it for the landmark bonus!", "bonus")
			end
			broadcast({ phase = phase, timeLeft = left, landmarkIn = math.max(0, math.ceil(A.landmarkOpenSeconds - elapsed)) })
			if left <= 0 or roundOver() then
				break
			end
		end
		phase = "Results"
		roundsPlayed += 1
		local rows = leaderboard()
		local best = rows[1]
		if best and best.userId ~= 0 then
			local player = Players:GetPlayerByUserId(best.userId)
			local ls = player and player:FindFirstChild("leaderstats")
			local wins = ls and ls:FindFirstChild("Wins") :: IntValue?
			if wins then
				wins.Value += 1
			end
		end
		broadcast({ phase = phase, timeLeft = Config.RESULTS_SECONDS, rows = rows, awards = awards(rows) })
		task.wait(Config.RESULTS_SECONDS)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[--!strict
-- The web game's own models in Roblox. Each one was exported to GLB (tools/model-export), uploaded
-- as an asset (roblox/upload-assets.sh) and listed in Shared.AssetIds. Loading flattens the asset
-- into one Model, repaints every MeshPart from Shared.ModelInfo (the importer's colours are not
-- trusted), scales it to real size (metres × STUDS_PER_METER, whatever unit the importer used)
-- and puts the pivot on the web model's own origin, so a web position/yaw places it exactly.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetIds = require(Shared:WaitForChild("AssetIds"))
local ModelInfo = require(Shared:WaitForChild("ModelInfo"))
local Config = require(Shared:WaitForChild("Config"))

local K = Config.STUDS_PER_METER

local Models = {}

-- Material names used by Shared.ModelInfo (see tools/roblox-modelinfo.mjs).
local MATERIALS: { [string]: Enum.Material } = {}
for _, name in { "Neon", "Glass", "Metal", "CorrodedMetal", "Plastic", "SmoothPlastic", "Brick", "Concrete", "Limestone", "Pavement", "Asphalt", "Pebble", "Rubber", "WoodPlanks", "Wood", "Fabric", "Cardboard" } do
	MATERIALS[name] = (Enum.Material :: any)[name]
end

-- Templates live in ReplicatedStorage: clients clone the machine models locally (Play.client).
local store = Instance.new("Folder")
store.Name = "ModelTemplates"
store.Parent = ReplicatedStorage

local templates: { [string]: Model } = {}
local loading: { [string]: boolean } = {}
local failed: { [string]: boolean } = {}

local function prepare(name: string, asset: Instance): Model?
	local info = ModelInfo[name]
	local model = Instance.new("Model")
	model.Name = name
	model.WorldPivot = CFrame.new()
	local count = 0
	for _, d in asset:GetDescendants() do
		if d:IsA("BasePart") then
			local mesh = info and info.meshes[d.Name]
			if mesh then
				d.Color = Color3.fromHex(mesh.c)
				d.Material = MATERIALS[mesh.m] or Enum.Material.SmoothPlastic
				d.Transparency = mesh.t
				if mesh.tint then
					d:SetAttribute("Tint", true)
				end
			end
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Parent = model
			count += 1
		end
	end
	asset:Destroy()
	if count == 0 or not info then
		model:Destroy()
		return nil
	end
	-- Scale to real size, then put the pivot where the web model's origin is: the box's low
	-- corner sits at info.min (metres) from the origin.
	local _, size = model:GetBoundingBox()
	local metres = info.size
	local biggest = math.max(metres.X, metres.Y, metres.Z)
	local actual = if biggest == metres.X then size.X elseif biggest == metres.Y then size.Y else size.Z
	model:ScaleTo(biggest * K / actual)
	local box, scaled = model:GetBoundingBox()
	local low = box.Position - scaled / 2
	model.WorldPivot = CFrame.new(low - info.min * K)
	model.Parent = store
	return model
end

-- Load (once) and return the template, or nil when the model has no asset id or failed to load.
-- Yields while LoadAsset runs; concurrent callers for the same name wait for the first one.
function Models.load(name: string): Model?
	while loading[name] do
		task.wait()
	end
	if templates[name] then
		return templates[name]
	end
	local id = AssetIds[name]
	if not id or failed[name] then
		return nil
	end
	loading[name] = true
	local ok, result = pcall(InsertService.LoadAsset, InsertService, id)
	local model = if ok then prepare(name, result :: Instance) else nil
	if model then
		templates[name] = model
	else
		failed[name] = true
		warn(string.format("Models: %s (%d) did not load: %s", name, id, if ok then "no parts" else tostring(result)))
	end
	loading[name] = nil
	return model
end

-- Real size in studs a model should have (for the self-check).
function Models.expectedSize(name: string): Vector3?
	local info = ModelInfo[name]
	return if info then info.size * K else nil
end

-- Load many models in parallel and wait for all of them.
function Models.preload(names: { string })
	local pending = 0
	for _, name in names do
		if AssetIds[name] and not templates[name] and not failed[name] then
			pending += 1
			task.spawn(function()
				Models.load(name)
				pending -= 1
			end)
		end
	end
	while pending > 0 do
		task.wait()
	end
end

-- A fresh copy at real size (× extra scale), pivot on the web origin (not parented).
-- tint recolours the meshes the web game paints per instance (TINTED roles): the exported
-- colour is the type's first colour × its texture tone, so the instance colour keeps that tone.
function Models.clone(name: string, scale: number?, tint: Color3?, baseTint: Color3?): Model?
	local template = Models.load(name)
	if not template then
		return nil
	end
	local m = template:Clone()
	if scale and scale ~= 1 then
		-- ScaleTo is absolute (relative to the original import), and the template is already scaled.
		m:ScaleTo(m:GetScale() * scale)
	end
	if tint and baseTint then
		for _, p in m:GetDescendants() do
			if p:IsA("BasePart") and p:GetAttribute("Tint") then
				local c = p.Color
				local function ch(v: number, from: number, to: number): number
					return if from > 0.001 then math.clamp(v * to / from, 0, 1) else to
				end
				p.Color = Color3.new(ch(c.R, baseTint.R, tint.R), ch(c.G, baseTint.G, tint.G), ch(c.B, baseTint.B, tint.B))
			end
		end
	end
	return m
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- One web city in Roblox: the street scenery model, every gameplay object of the arena layout
-- (exported from the web World, Shared.Cities.<id>) and the object life cycle the web World runs:
-- idle → pulled into a machine → absorbed, and supported landmark parts falling when their
-- supports are eaten. Positions are metres (web units); models are placed at × STUDS_PER_METER.
--
-- Clients read each object from its model in workspace.Arena.Objects: attributes Id, Type, X, Y,
-- Z, Yaw (metres), State ("idle" | "pulled" | "falling") and Anchored.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local WebConfig = require(Shared:WaitForChild("WebConfig"))
local Growth = require(Shared:WaitForChild("Growth"))
local Collision = require(Shared:WaitForChild("Collision"))
local Models = require(script.Parent:WaitForChild("Models"))

local K = Config.STUDS_PER_METER
local OBJECTS = WebConfig.objects

export type Obj = {
	id: number,
	type: string,
	def: any,
	x: number,
	y: number,
	z: number,
	yaw: number,
	color: Color3,
	model: Model?,
	state: string, -- "idle" | "pulled" | "falling" | "gone"
	anchored: boolean,
	supports: { number },
	requiredPower: number,
	radius: number,
	-- pull
	owner: any,
	pullTime: number,
	phase: number,
	vx: number,
	vy: number,
	vz: number,
	spin: number,
	-- fall
	fallVy: number,
	tilt: number,
	-- refill (ArenaGame refill): home pose, the colours to rebuild it, when it may come back
	home: { number },
	base0: Color3,
	refillAt: number?,
}

local World = {}
-- Time source for refills (tests run on simulated time).
World.clock = os.clock
World.city = nil :: any
World.objects = {} :: { Obj }
World.ground = function(_x: number, _z: number): number
	return 0
end
World.colliders = {} :: { Collision.Box }

local arena: Folder? = nil

-- Broad phase: 8 m cells (World.ts GRID_CELL). Objects that move (fall) are re-added; stale
-- entries are skipped by checking the object's current cell.
local CELL = 8
local grid: { [number]: { Obj } } = {}
local function cellKey(cx: number, cz: number): number
	return (cx + 4096) * 8192 + (cz + 4096)
end
local function addToGrid(o: Obj)
	local k = cellKey(math.floor(o.x / CELL), math.floor(o.z / CELL))
	local list = grid[k]
	if not list then
		list = {}
		grid[k] = list
	end
	table.insert(list, o)
end

-- Objects whose footprint may touch a circle at (x, z, r).
function World.near(x: number, z: number, r: number): { Obj }
	local out: { Obj } = {}
	local seen: { [Obj]: boolean } = {}
	for cx = math.floor((x - r - 6) / CELL), math.floor((x + r + 6) / CELL) do
		for cz = math.floor((z - r - 6) / CELL), math.floor((z + r + 6) / CELL) do
			local list = grid[cellKey(cx, cz)]
			if list then
				for _, o in list do
					if not seen[o] and o.state ~= "gone" then
						seen[o] = true
						table.insert(out, o)
					end
				end
			end
		end
	end
	return out
end

local function place(o: Obj)
	local m = o.model
	if not m then
		return
	end
	m:PivotTo(CFrame.new(o.x * K, o.y * K, o.z * K) * CFrame.Angles(0, o.yaw, 0) * CFrame.Angles(o.tilt, 0, 0))
end

local function syncAttributes(o: Obj)
	local m = o.model
	if not m then
		return
	end
	m:SetAttribute("X", o.x)
	m:SetAttribute("Y", o.y)
	m:SetAttribute("Z", o.z)
	m:SetAttribute("Yaw", o.yaw)
	m:SetAttribute("State", o.state)
	m:SetAttribute("Anchored", o.anchored)
end

-- Fallback street scenery from the city data when the scenery model cannot be loaded: the ground
-- grid as asphalt (roads) and raised pavement (kerb height), and the static buildings as boxes.
local BLOCK_COLORS: { [string]: Color3 } = {
	brick = Color3.fromRGB(150, 82, 62), darkBrick = Color3.fromRGB(96, 70, 60), plaster = Color3.fromRGB(196, 186, 166),
	concrete = Color3.fromRGB(150, 150, 146), steel = Color3.fromRGB(120, 130, 140),
}
local BLOCK_MATERIALS: { [string]: Enum.Material } = {
	brick = Enum.Material.Brick, darkBrick = Enum.Material.Brick, plaster = Enum.Material.Concrete,
	concrete = Enum.Material.Concrete, steel = Enum.Material.Metal,
}
local function fallbackScenery(city: any, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "FallbackScenery"
	folder.Parent = parent
	local function slab(x0: number, x1: number, z0: number, z1: number, h: number)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		local top = math.max(h, 0.001)
		p.Size = Vector3.new((x1 - x0) * K, (top + 0.5) * K, (z1 - z0) * K)
		p.CFrame = CFrame.new((x0 + x1) / 2 * K, (top - 0.5) / 2 * K, (z0 + z1) / 2 * K)
		if h > 0.01 then
			p.Color = Color3.fromRGB(176, 174, 168)
			p.Material = Enum.Material.Pavement
		else
			p.Color = Color3.fromRGB(70, 70, 72)
			p.Material = Enum.Material.Asphalt
		end
		p.Parent = folder
	end
	-- Rows of runs → rectangles, merging identical consecutive rows.
	local g = city.ground
	local prevRow: string? = nil
	local startZ = g.z0
	local function flush(row: string, z0: number, z1: number)
		local x = g.x0
		for h, n in string.gmatch(row, "([%-%d%.]+)%*(%d+)") do
			local count = tonumber(n) :: number
			slab(x, x + count, z0, z1, tonumber(h) :: number)
			x += count
		end
	end
	for i, row in g.rows do
		local z = g.z0 + i - 1
		if row ~= prevRow then
			if prevRow then
				flush(prevRow, startZ, z)
			end
			prevRow = row
			startZ = z
		end
	end
	if prevRow then
		flush(prevRow, startZ, g.z0 + #g.rows)
	end
	for _, b in city.blocks or {} do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = Vector3.new(b[4], b[5], b[6]) * K
		p.CFrame = CFrame.new(b[1] * K, (b[2] + b[5] / 2) * K, b[3] * K)
		p.Color = BLOCK_COLORS[b[7]] or BLOCK_COLORS.concrete
		p.Material = BLOCK_MATERIALS[b[7]] or Enum.Material.Concrete
		p.Parent = folder
	end
end

-- Build a city; returns its module. Yields while models load.
function World.build(cityId: string)
	if arena then
		arena:Destroy()
	end
	local city = require(Shared:WaitForChild("Cities"):WaitForChild(cityId)) :: any
	World.city = city
	World.ground = Collision.groundLookup(city.ground)
	World.colliders = city.colliders
	World.objects = {}
	table.clear(grid)

	local names: { string } = { city.scenery }
	local seen: { [string]: boolean } = {}
	for _, row in city.objects do
		if not seen[row[1]] then
			seen[row[1]] = true
			table.insert(names, row[1])
		end
	end
	Models.preload(names)

	local root = Instance.new("Folder")
	root.Name = "Arena"
	root:SetAttribute("City", cityId)
	local scenery = Models.clone(city.scenery)
	if scenery then
		scenery.Name = "Scenery"
		scenery:PivotTo(CFrame.new())
		for _, p in scenery:GetDescendants() do
			if p:IsA("BasePart") then
				p.CastShadow = true
			end
		end
		scenery.Parent = root
	else
		warn("World: scenery " .. city.scenery .. " missing, building the fallback street scenery")
		fallbackScenery(city, root)
	end
	-- Fallback ground so machines never fall through when the scenery did not load.
	local base = Instance.new("Part")
	base.Name = "Ground"
	base.Anchored = true
	base.Size = Vector3.new((city.bounds.maxX - city.bounds.minX) * K + 400, 2, (city.bounds.maxZ - city.bounds.minZ) * K + 400)
	base.CFrame = CFrame.new(0, -1.05, 0)
	base.Color = Color3.fromRGB(80, 79, 78)
	base.Material = Enum.Material.Asphalt
	base.Parent = root

	-- Street-tree canopies: the web's leaf cards (alpha-tested) cannot be MeshParts, so each crown
	-- is a cluster of leafy balls where the web crown sits (trunk 2.6–3.4 m, crown 1.6–2.2 m above
	-- it, radius 1.9–2.5 m × the city's crown scale, squashed to 0.72 in height).
	local canopies = Instance.new("Folder")
	canopies.Name = "Canopies"
	canopies.Parent = root
	local leafRng = Random.new(1)
	for _, t in city.trees do
		local tx, treeBase, tz = t[1], t[2], t[3]
		local radius = (1.9 + leafRng:NextNumber() * 0.6) * (city.canopyScale or 1)
		local cy = treeBase + 3 + 1.9
		local green = Color3.fromRGB(70 + leafRng:NextInteger(0, 25), 110 + leafRng:NextInteger(0, 30), 55 + leafRng:NextInteger(0, 15))
		for k = 1, 4 do
			local a = k * 2.1 + leafRng:NextNumber()
			local off = if k == 1 then Vector3.zero else Vector3.new(math.cos(a) * radius * 0.45, (leafRng:NextNumber() - 0.3) * radius * 0.3, math.sin(a) * radius * 0.45)
			local r = if k == 1 then radius else radius * (0.6 + leafRng:NextNumber() * 0.2)
			local ball = Instance.new("Part")
			ball.Shape = Enum.PartType.Ball
			ball.Anchored = true
			ball.CanCollide = false
			ball.CanQuery = false
			ball.CanTouch = false
			ball.Material = Enum.Material.LeafyGrass
			ball.Color = green
			ball.Size = Vector3.one * r * 2 * K
			ball.CFrame = CFrame.new((Vector3.new(tx, cy, tz) + off) * K)
			ball.Parent = canopies
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Objects"
	folder.Parent = root

	for i, row in city.objects do
		local typeId, x, y, z, yaw, colorHex, supports, anchored = row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8]
		local def = OBJECTS[typeId]
		local color = Color3.fromHex(colorHex)
		local base0 = Color3.fromHex(string.format("%06x", def.colors[1]))
		local o: Obj = {
			id = i,
			type = typeId,
			def = def,
			x = x,
			y = y,
			z = z,
			yaw = yaw,
			color = color,
			model = nil,
			state = "idle",
			anchored = anchored,
			supports = supports or {},
			requiredPower = Growth.requiredPower(typeId),
			radius = math.sqrt((def.size[1] / 2) ^ 2 + (def.size[3] / 2) ^ 2),
			owner = nil,
			pullTime = 0,
			phase = 0,
			vx = 0,
			vy = 0,
			vz = 0,
			spin = 0,
			fallVy = 0,
			tilt = 0,
			home = { x, y, z, yaw },
			base0 = base0,
			refillAt = nil,
		}
		local m = Models.clone(typeId, 1, color, base0)
		if m then
			m.Name = tostring(i)
			m:SetAttribute("Id", i)
			m:SetAttribute("Type", typeId)
			o.model = m
			place(o)
			syncAttributes(o)
			m.Parent = folder
		end
		World.objects[i] = o
		addToGrid(o)
	end
	root.Parent = workspace
	arena = root
	-- Self-check in the Output window: what loaded, where the scenery sits, what is missing.
	local withModel, missing = 0, {}
	for _, o in World.objects do
		if o.model then
			withModel += 1
		else
			missing[o.type] = true
		end
	end
	local missingList = {}
	for t in missing do
		table.insert(missingList, t)
	end
	local sceneryInfo = "missing"
	if scenery then
		local box, size = scenery:GetBoundingBox()
		sceneryInfo = string.format("centre %s size %s studs (expected size %s)", tostring(box.Position), tostring(size), tostring(Models.expectedSize(city.scenery)))
	end
	print(string.format("[GrowEverything] %s: scenery %s; %d/%d objects with models; missing types: %s", cityId, sceneryInfo, withModel, #World.objects, if #missingList > 0 then table.concat(missingList, ", ") else "none"))
	return city
end

-- Absorbable by a machine of this power right now (web World.isEligible + the landmark lock).
function World.eligible(o: Obj, power: number, landmarkOpen: boolean): boolean
	if o.state ~= "idle" or o.anchored then
		return false
	end
	if o.def.climax and not landmarkOpen then
		return false
	end
	return power >= o.requiredPower
end

-- Start pulling an object into a machine (the server granted the claim).
function World.startPull(o: Obj, owner: any)
	o.state = "pulled"
	o.owner = owner
	o.pullTime = 0
	o.vx, o.vy, o.vz = 0, 0, 0
	o.spin = 0
	local cls = o.def.objectClass
	-- Destruction beat for big objects: longer the bigger the class (collection.heavyPhasePerClass).
	o.phase = if cls >= 4 then 0.25 * (1 + math.max(0, cls - 5) * WebConfig.collection.heavyPhasePerClass) else 0
	if o.model then
		o.model:SetAttribute("State", "pulled")
		o.model:SetAttribute("Owner", owner.id)
	end
end

-- What an absorbed object held up may fall (web World.releaseDependents): a spanning "collapse"
-- member fails as soon as any support goes; a stacked object only once every support is gone
-- (absorbed or itself falling). Tall "topple" parts fly toward the support that failed. Cascades.
local function release(removed: Obj, from: Obj)
	for _, o in World.objects do
		if o.state == "idle" and table.find(o.supports, removed.id) then
			local fall = o.def.destructionType == "collapse"
			if not fall then
				fall = true
				for _, sid in o.supports do
					local s = World.objects[sid]
					if s and s.state ~= "gone" and s.state ~= "falling" then
						fall = false
						break
					end
				end
			end
			if fall then
				o.state = "falling"
				o.fallVy = 0
				o.vx, o.vz = 0, 0
				local dx, dz = from.x - o.x, from.z - o.z
				local len = math.sqrt(dx * dx + dz * dz)
				local drop = o.y - World.ground(o.x, o.z)
				if o.def.topple and drop > 3 then
					local reach = math.min(drop * 0.45, 22)
					local t = math.sqrt(2 * drop / 9.8)
					local nx, nz
					if len > 0.5 then
						nx, nz = dx / len, dz / len
					else
						nx, nz = math.cos((o.id - 1) * 2.4), math.sin((o.id - 1) * 2.4)
					end
					o.vx = nx * reach / t
					o.vz = nz * reach / t
				end
				syncAttributes(o)
				release(o, from)
			end
		end
	end
end

-- Remove an absorbed object and release what it held up. Small and medium props that are not
-- landmark parts and not stacked come back at home later (arena refill).
local A = WebConfig.arena
function World.remove(o: Obj)
	o.state = "gone"
	if o.def.objectClass <= A.refillMaxClass and not o.def.climax and #o.supports == 0 then
		o.refillAt = World.clock() + A.refillDelay + o.def.objectClass * A.refillPerClass
	end
	if o.model then
		o.model:Destroy()
		o.model = nil
	end
	release(o, o)
end

-- Pull simulation for one object toward its owner's intake; returns true when absorbed.
local CC = WebConfig.collection
function World.stepPull(o: Obj, dt: number, ownerX: number, ownerZ: number, ownerY: number, heading: number, diameter: number, pull: number): boolean
	o.pullTime += dt
	if o.pullTime < o.phase then
		-- Destruction beat: crush/collapse objects squash, rip objects tilt up.
		local k = o.pullTime / math.max(0.001, o.phase)
		if o.def.destructionType == "rip" then
			o.tilt = -0.5 * k
		end
		place(o)
		return false
	end
	-- Fly to the intake: 0.3·d ahead of the machine at 0.32·d height.
	local tx = ownerX - math.sin(heading) * diameter * 0.3
	local tz = ownerZ - math.cos(heading) * diameter * 0.3
	local ty = ownerY + diameter * 0.32
	local cy = o.y + o.def.size[2] * 0.5
	local dx, dy, dz = tx - o.x, ty - cy, tz - o.z
	local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
	local arrived = dist < diameter * CC.absorbDistanceFactor + o.radius * 0.25 or o.pullTime > CC.maxPullSeconds / pull + o.phase
	if arrived then
		return true
	end
	local accel = CC.pullAcceleration * (0.4 + diameter) * pull
	local damp = math.exp(-5 * dt)
	local inv = 1 / math.max(dist, 1e-3)
	o.vx = o.vx * damp + dx * inv * accel * dt
	o.vy = o.vy * damp + dy * inv * accel * dt + 2.5 * diameter * dt
	o.vz = o.vz * damp + dz * inv * accel * dt
	o.x += o.vx * dt
	o.y += o.vy * dt
	o.z += o.vz * dt
	local t = o.pullTime - o.phase
	o.spin += (6 + 10 * t) * dt
	o.yaw += (6 + 10 * t) * dt
	local m = o.model
	if m then
		local s = math.max(0.3, 1 - 0.8 * t)
		local base = m:GetAttribute("BaseScale") :: number?
		if not base then
			base = m:GetScale()
			m:SetAttribute("BaseScale", base)
		end
		m:ScaleTo((base :: number) * s)
	end
	place(o)
	return false
end

-- Falling parts (web World.updateFalling): gravity, drift from a topple, slump; on landing they
-- become idle, unanchored objects on the ground. Returns the ones that landed this step.
function World.stepFalling(dt: number): { Obj }
	local landed: { Obj } = {}
	local b = World.city and World.city.bounds
	for _, o in World.objects do
		if o.state == "falling" then
			o.fallVy -= 9.8 * dt
			o.y += o.fallVy * dt
			if (o.vx ~= 0 or o.vz ~= 0) and b then
				o.x = math.clamp(o.x + o.vx * dt, b.minX + o.radius, b.maxX - o.radius)
				o.z = math.clamp(o.z + o.vz * dt, b.minZ + o.radius, b.maxZ - o.radius)
			end
			o.tilt += dt * 0.35 * (if o.id % 2 == 0 then 1 else -1) -- slump as it drops (web ids are 0-based)
			local g = World.ground(o.x, o.z)
			if o.y <= g then
				o.y = g
				o.state = "idle"
				o.anchored = false
				o.fallVy, o.vx, o.vz = 0, 0, 0
				o.tilt = math.clamp(o.tilt, -0.12, 0.12)
				syncAttributes(o)
				addToGrid(o)
				table.insert(landed, o)
			end
			place(o)
		end
	end
	return landed
end

-- Refill due objects whose home is clear of machines ({x, z, diameter} each); at most
-- refillPerCheck per call. Returns how many came back.
function World.refill(machines: { { number } }): number
	local n = 0
	local t = World.clock()
	local folder = arena and arena:FindFirstChild("Objects")
	for _, o in World.objects do
		if n >= A.refillPerCheck then
			break
		end
		if o.state == "gone" and o.refillAt and t >= o.refillAt then
			local hx, hy, hz, hyaw = o.home[1], o.home[2], o.home[3], o.home[4]
			local clear = true
			for _, m in machines do
				local need = A.refillClearance + math.min(2 * m[3], A.refillClearanceMaxExtra) + o.radius
				if (m[1] - hx) ^ 2 + (m[2] - hz) ^ 2 < need * need then
					clear = false
					break
				end
			end
			if clear then
				o.x, o.y, o.z, o.yaw, o.tilt = hx, hy, hz, hyaw, 0
				o.state = "idle"
				o.refillAt = nil
				o.vx, o.vy, o.vz = 0, 0, 0
				local m = Models.clone(o.type, 1, o.color, o.base0)
				if m and folder then
					m.Name = tostring(o.id)
					m:SetAttribute("Id", o.id)
					m:SetAttribute("Type", o.type)
					o.model = m
					place(o)
					syncAttributes(o)
					m.Parent = folder
				end
				addToGrid(o)
				n += 1
			end
		end
	end
	return n
end

-- Solid for a machine of this power (web World.isSolid): held up in the air = pass underneath.
function World.solid(o: Obj, power: number, landmarkOpen: boolean): boolean
	if o.state ~= "idle" then
		return false
	end
	if o.y > World.ground(o.x, o.z) + 2.5 then
		return false
	end
	return o.anchored or not World.eligible(o, power, landmarkOpen)
end

function World.box(o: Obj): Collision.Box
	return { o.x, o.z, o.def.size[1] / 2, o.def.size[3] / 2, o.yaw }
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Feel</string>
            <string name="Source"><![CDATA[--!strict
-- Game feel on the client, after the web game's systems/Effects.ts and audio/AudioEngine.ts:
--  * sounds: the web's own procedural effects rendered into one sprite (Shared.Sfx, uploaded as
--    AssetIds.GrowSfx) played with Sound.PlaybackRegion; pickup ticks climb a pentatonic ladder
--    while chained, like the web;
--  * camera trauma (shake = trauma², decays 1.4/s, 17 Hz, max 6% of camera distance), a timed
--    pull-back (tier up, landmark) and a dash FOV kick;
--  * particles: burst, shards, dust, sparks and a ground pulse ring.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WebConfig = require(Shared:WaitForChild("WebConfig"))
local AssetIds = require(Shared:WaitForChild("AssetIds"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local FEEL = WebConfig.feel

local Feel = {}

-- Sounds -----------------------------------------------------------------------------------------
local spriteId = AssetIds.GrowSfx
-- Built-in engine sounds stand in until the sprite is uploaded.
local FALLBACK: { [string]: string } = {
	absorb_tick = "rbxasset://sounds/electronicpingshort.wav",
	absorb_small = "rbxasset://sounds/electronicpingshort.wav",
	tier = "rbxasset://sounds/victory.wav",
	win = "rbxasset://sounds/victory.wav",
	eaten = "rbxasset://sounds/uuhhh.mp3",
	beep_low = "rbxasset://sounds/clickfast.wav",
	beep_high = "rbxasset://sounds/clickfast.wav",
}
local function playSound(name: string, volume: number?, speed: number?)
	local s = Instance.new("Sound")
	s.Volume = volume or 0.8
	s.PlaybackSpeed = speed or 1
	local region = Sfx[name]
	if spriteId and region then
		s.SoundId = "rbxassetid://" .. spriteId
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[1] + region[2])
	else
		local id = FALLBACK[name]
		if not id then
			s:Destroy()
			return
		end
		s.SoundId = id
	end
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, ((region and region[2]) or 3) / (speed or 1) + 0.5)
end

function Feel.play(name: string, volume: number?, speed: number?)
	playSound(name, volume, speed)
end

-- Pickup tick: chained pickups climb STREAK_STEPS (semitones) within 0.7 s (AudioEngine.tick).
local STREAK_STEPS = { 0, 2, 4, 7, 9, 12, 14, 16, 19, 21, 24 }
local streak, lastStreak = 0, -10
function Feel.tick(size: number)
	local t = os.clock()
	streak = if t - lastStreak < 0.7 then math.min(#STREAK_STEPS - 1, streak + 1) else 0
	lastStreak = t
	-- The rendered tick is the base pitch for a 0.1 m object; size lowers it like the web.
	local base = math.max(500, 1150 - size * 700) / math.max(500, 1150 - 0.1 * 700)
	playSound("absorb_tick", 0.6, base * 2 ^ (STREAK_STEPS[streak + 1] / 12))
end

-- Absorb sound by class (AudioEngine.handle 'absorb').
function Feel.absorb(cls: number, size: number)
	if cls <= 2 then
		Feel.tick(size)
	elseif cls == 3 then
		playSound("absorb_3")
	elseif cls == 4 then
		playSound("absorb_4")
	elseif cls <= 6 then
		playSound("absorb_5")
	elseif cls <= 8 then
		playSound("absorb_7")
	else
		playSound("absorb_9")
	end
end

function Feel.crunch(cls: number)
	playSound(if cls >= 8 then "crunch_8" elseif cls >= 6 then "crunch_6" else "crunch_4")
end

-- Camera feel ------------------------------------------------------------------------------------
local trauma = 0
local pull, pullUntil, pullTotal = 0, 0, 1
local fovKick = 0

function Feel.trauma(amount: number)
	trauma = math.min(1, trauma + amount)
end

-- Trauma from something at distance `dist` m (fades past 45 m + 3 × size, like the web).
function Feel.traumaAt(amount: number, dist: number, size: number)
	local falloff = 45 + size * 3
	if dist < falloff * 2 then
		Feel.trauma(amount * math.clamp(1 - dist / (falloff * 2), 0, 1))
	end
end

function Feel.pullBack(amount: number, seconds: number)
	pull = amount
	pullTotal = seconds
	pullUntil = os.clock() + seconds
end

function Feel.kickFov(deg: number)
	fovKick = math.max(fovKick, deg)
end

-- Per frame: returns a camera offset (studs), a distance multiplier and extra FOV degrees.
function Feel.camera(dt: number, distance: number): (Vector3, number, number)
	trauma = math.max(0, trauma - FEEL.traumaDecay * dt)
	local s = trauma * trauma
	local t = os.clock() * 17
	local offset = Vector3.new(math.noise(t, 0.3) * 2, math.noise(t, 4.1) * 2, math.noise(t, 9.7) * 2) * s * FEEL.maxShakeOffset * distance
	local left = pullUntil - os.clock()
	local p = if left > 0 then pull * math.sin(math.clamp(left / pullTotal, 0, 1) * math.pi) else 0
	fovKick = math.max(0, fovKick - 5 * fovKick * dt)
	return offset, 1 + p, fovKick + p * 30
end

-- Particles --------------------------------------------------------------------------------------
local fxFolder = Instance.new("Folder")
fxFolder.Name = "Fx"
fxFolder.Parent = workspace

local function emitter(position: Vector3, props: { [string]: any }, count: number, life: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one * 0.1
	p.Position = position
	local a = Instance.new("Attachment")
	a.Parent = p
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = a
	p.Parent = fxFolder
	e:Emit(count)
	Debris:AddItem(p, life + 0.5)
end

-- Shards: chunky coloured bits flung out and falling (Effects.shards).
function Feel.shards(position: Vector3, color: Color3, count: number, size: number, speed: number)
	emitter(position, {
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(size),
		Speed = NumberRange.new(speed * 0.5, speed),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -workspace.Gravity * 0.6, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-300, 300),
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		LightEmission = 0,
		Transparency = NumberSequence.new(0, 1),
	}, count, 0.9)
end

function Feel.dust(position: Vector3, radius: number, count: number)
	emitter(position, {
		Color = ColorSequence.new(Color3.fromRGB(190, 180, 165)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, radius * 0.4), NumberSequenceKeypoint.new(1, radius * 1.4) }),
		Speed = NumberRange.new(radius * 0.4, radius * 1.2),
		SpreadAngle = Vector2.new(90, 20),
		Lifetime = NumberRange.new(0.8, 1.4),
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		Drag = 2,
	}, count, 1.4)
end

function Feel.sparks(position: Vector3, count: number, speed: number)
	emitter(position, {
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 90)),
		Size = NumberSequence.new(0.3, 0),
		Speed = NumberRange.new(speed * 0.5, speed),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -workspace.Gravity * 0.4, 0),
		Lifetime = NumberRange.new(0.25, 0.5),
		LightEmission = 1,
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
	}, count, 0.5)
end

-- A small burst (pop at the intake, absorb burst).
function Feel.burst(position: Vector3, color: Color3, count: number, size: number)
	emitter(position, {
		Color = ColorSequence.new(color),
		Size = NumberSequence.new(size, 0),
		Speed = NumberRange.new(size * 4, size * 9),
		SpreadAngle = Vector2.new(180, 180),
		Lifetime = NumberRange.new(0.25, 0.45),
		LightEmission = 0.6,
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
	}, count, 0.45)
end

-- Ground pulse ring (tier up, landmark, being eaten).
function Feel.pulse(position: Vector3, radius: number, color: Color3?)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color or Color3.fromHex("ffb347")
	ring.Transparency = 0.3
	ring.Size = Vector3.new(0.2, 1, 1)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = fxFolder
	game:GetService("TweenService"):Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.8)
end

return Feel
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="30">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox) HUD, after the web game's (ui/Hud.ts + arena/ArenaUi.ts):
--  top centre: round timer, "City · Landmark n/total", landmark lock line; centre: countdown / GO;
--  bottom-left: MASS panel (TIER chip, kg/t, progress bar with ticks, tier name, NEXT · class · mass)
--  with the "+N kg" pop; next to it combo and power-up timers; top banner for unlocks, tiers and
--  landmark moments; toasts; bottom-right controls legend; results card.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WebConfig = require(Shared:WaitForChild("WebConfig"))
local Growth = require(Shared:WaitForChild("Growth"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local AbsorbedEvent = remotes:WaitForChild("Absorbed") :: RemoteEvent
local RoundEvent = remotes:WaitForChild("RoundState") :: RemoteEvent
local NoticeEvent = remotes:WaitForChild("Notice") :: RemoteEvent
local Feel = require(script.Parent:WaitForChild("Feel"))

local ORANGE = Color3.fromHex("ffb347")
local ORANGE_DARK = Color3.fromHex("d97a14")
local PANEL = Color3.fromRGB(16, 17, 20)
local DIM = Color3.fromRGB(170, 170, 176)

local CITY_TEXT: { [string]: { city: string, landmark: string } } = {
	shanghai = { city = "Shanghai", landmark = "Oriental Pearl Tower" },
	newyork = { city = "New York", landmark = "Empire State Building" },
	paris = { city = "Paris", landmark = "Eiffel Tower" },
}

local gui = Instance.new("ScreenGui")
gui.Name = "GrowHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(p: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = p
end
local function text(parent: Instance, name: string, size: number, font: Enum.Font, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Font = font
	l.TextSize = size
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.Text = ""
	l.Parent = parent
	return l
end
local function shadow(l: TextLabel)
	l.TextStrokeTransparency = 0.6
	l.TextStrokeColor3 = Color3.new(0, 0, 0)
end

-- Top centre: timer + sub-lines.
local timer = text(gui, "Timer", 34, Enum.Font.GothamBlack)
timer.AnchorPoint = Vector2.new(0.5, 0)
timer.Position = UDim2.new(0.5, 0, 0, 14)
timer.Size = UDim2.fromOffset(200, 40)
shadow(timer)
local subline = text(gui, "Sub", 14, Enum.Font.GothamBold, Color3.fromRGB(235, 235, 240))
subline.AnchorPoint = Vector2.new(0.5, 0)
subline.Position = UDim2.new(0.5, 0, 0, 54)
subline.Size = UDim2.fromOffset(420, 18)
shadow(subline)
local lockLine = text(gui, "Lock", 14, Enum.Font.GothamBold, ORANGE)
lockLine.AnchorPoint = Vector2.new(0.5, 0)
lockLine.Position = UDim2.new(0.5, 0, 0, 74)
lockLine.Size = UDim2.fromOffset(420, 18)
shadow(lockLine)

-- Centre message (countdown, GO, waiting).
local center = text(gui, "Center", 64, Enum.Font.GothamBlack)
center.AnchorPoint = Vector2.new(0.5, 0.5)
center.Position = UDim2.fromScale(0.5, 0.42)
center.Size = UDim2.fromOffset(600, 80)
shadow(center)
local centerSub = text(gui, "CenterSub", 20, Enum.Font.GothamBold, ORANGE)
centerSub.AnchorPoint = Vector2.new(0.5, 0)
centerSub.Position = UDim2.new(0.5, 0, 0.42, 44)
centerSub.Size = UDim2.fromOffset(600, 26)
shadow(centerSub)

-- Banner (top, 11%): big line, rule, orange sub-line.
local banner = Instance.new("Frame")
banner.Name = "Banner"
banner.BackgroundTransparency = 1
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.Position = UDim2.fromScale(0.5, 0.11)
banner.Size = UDim2.fromOffset(900, 90)
banner.Visible = false
banner.Parent = gui
local bannerBig = text(banner, "Big", 38, Enum.Font.GothamBlack)
bannerBig.Size = UDim2.new(1, 0, 0, 46)
shadow(bannerBig)
local bannerRule = Instance.new("Frame")
bannerRule.BackgroundColor3 = ORANGE
bannerRule.BorderSizePixel = 0
bannerRule.AnchorPoint = Vector2.new(0.5, 0)
bannerRule.Position = UDim2.new(0.5, 0, 0, 52)
bannerRule.Size = UDim2.fromOffset(260, 2)
bannerRule.Parent = banner
local bannerSub = text(banner, "Sub", 16, Enum.Font.GothamBold, ORANGE)
bannerSub.Position = UDim2.fromOffset(0, 60)
bannerSub.Size = UDim2.new(1, 0, 0, 22)
shadow(bannerSub)
local bannerToken = 0
local function showBanner(big: string, sub: string, seconds: number?)
	bannerToken += 1
	local mine = bannerToken
	bannerBig.Text = big
	bannerSub.Text = sub
	banner.Visible = true
	task.delay(seconds or 2.2, function()
		if bannerToken == mine then
			banner.Visible = false
		end
	end)
end

-- Toast (60% height).
local toast = text(gui, "Toast", 20, Enum.Font.GothamBold)
toast.AnchorPoint = Vector2.new(0.5, 0.5)
toast.Position = UDim2.fromScale(0.5, 0.6)
toast.Size = UDim2.fromOffset(600, 30)
shadow(toast)
local toastToken = 0
local function showToast(s: string, color: Color3?)
	toastToken += 1
	local mine = toastToken
	toast.Text = s
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	task.delay(1.5, function()
		if toastToken == mine then
			toast.Text = ""
		end
	end)
end

-- Mass panel (bottom-left, 250 px).
local panel = Instance.new("Frame")
panel.Name = "MassPanel"
panel.AnchorPoint = Vector2.new(0, 1)
panel.Position = UDim2.new(0, 24, 1, -24)
panel.Size = UDim2.fromOffset(250, 132)
panel.BackgroundColor3 = PANEL
panel.BackgroundTransparency = 0.25
panel.Parent = gui
corner(panel, 12)
local pad = Instance.new("UIPadding")
pad.PaddingLeft = UDim.new(0, 14)
pad.PaddingRight = UDim.new(0, 14)
pad.PaddingTop = UDim.new(0, 10)
pad.Parent = panel
local massLabel = text(panel, "Label", 11, Enum.Font.GothamBold, DIM)
massLabel.Text = "MASS"
massLabel.TextXAlignment = Enum.TextXAlignment.Left
massLabel.Size = UDim2.new(1, 0, 0, 14)
local tierChip = text(panel, "Tier", 11, Enum.Font.GothamBlack, Color3.fromRGB(30, 20, 5))
tierChip.BackgroundTransparency = 0
tierChip.BackgroundColor3 = ORANGE
tierChip.AnchorPoint = Vector2.new(1, 0)
tierChip.Position = UDim2.new(1, 0, 0, 0)
tierChip.Size = UDim2.fromOffset(62, 18)
corner(tierChip, 5)
local massNumber = text(panel, "Number", 34, Enum.Font.GothamBlack)
massNumber.TextXAlignment = Enum.TextXAlignment.Left
massNumber.Position = UDim2.fromOffset(0, 18)
massNumber.Size = UDim2.new(1, 0, 0, 38)
local massGain = text(panel, "Gain", 16, Enum.Font.GothamBlack, ORANGE)
massGain.TextXAlignment = Enum.TextXAlignment.Left
massGain.Position = UDim2.fromOffset(0, -22)
massGain.Size = UDim2.new(1, 0, 0, 20)
massGain.TextTransparency = 1
local bar = Instance.new("Frame")
bar.Name = "Bar"
bar.Position = UDim2.fromOffset(0, 62)
bar.Size = UDim2.new(1, 0, 0, 6)
bar.BackgroundColor3 = Color3.fromRGB(60, 60, 66)
bar.BorderSizePixel = 0
bar.Parent = panel
corner(bar, 3)
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = Color3.new(1, 1, 1)
fill.BorderSizePixel = 0
fill.Parent = bar
corner(fill, 3)
local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new(ORANGE_DARK, ORANGE)
grad.Parent = fill
for _, f in { 0.25, 0.5, 0.75 } do
	local tick = Instance.new("Frame")
	tick.BackgroundColor3 = PANEL
	tick.BorderSizePixel = 0
	tick.Position = UDim2.fromScale(f, 0)
	tick.Size = UDim2.new(0, 2, 1, 0)
	tick.ZIndex = 2
	tick.Parent = bar
end
local tierName = text(panel, "TierName", 12, Enum.Font.GothamBold, DIM)
tierName.TextXAlignment = Enum.TextXAlignment.Left
tierName.Position = UDim2.fromOffset(0, 74)
tierName.Size = UDim2.new(1, 0, 0, 16)
local nextLine = Instance.new("TextLabel")
nextLine.Name = "Next"
nextLine.BackgroundTransparency = 1
nextLine.RichText = true
nextLine.Font = Enum.Font.GothamBold
nextLine.TextSize = 12
nextLine.TextColor3 = Color3.new(1, 1, 1)
nextLine.TextXAlignment = Enum.TextXAlignment.Left
nextLine.TextWrapped = true
nextLine.Position = UDim2.fromOffset(0, 92)
nextLine.Size = UDim2.new(1, 0, 0, 30)
nextLine.Parent = panel

-- Combo / power-up status (next to the mass panel).
local status = text(gui, "Status", 18, Enum.Font.GothamBlack, ORANGE)
status.AnchorPoint = Vector2.new(0, 1)
status.Position = UDim2.new(0, 288, 1, -30)
status.Size = UDim2.fromOffset(220, 80)
status.TextXAlignment = Enum.TextXAlignment.Left
status.TextYAlignment = Enum.TextYAlignment.Bottom
shadow(status)

-- Controls legend (bottom-right).
local legend = text(gui, "Legend", 12, Enum.Font.GothamBold, ORANGE)
legend.AnchorPoint = Vector2.new(1, 1)
legend.Position = UDim2.new(1, -20, 1, -18)
legend.Size = UDim2.fromOffset(320, 18)
legend.TextXAlignment = Enum.TextXAlignment.Right
legend.Text = "WASD MOVE · SPACE DASH · DRAG LOOK"
shadow(legend)

-- Results card.
local results = Instance.new("Frame")
results.Name = "Results"
results.AnchorPoint = Vector2.new(0.5, 0.5)
results.Position = UDim2.fromScale(0.5, 0.5)
results.Size = UDim2.fromOffset(560, 340)
results.BackgroundColor3 = PANEL
results.BackgroundTransparency = 0.1
results.Visible = false
results.Parent = gui
corner(results, 14)
local resultsTitle = text(results, "Title", 30, Enum.Font.GothamBlack, ORANGE)
resultsTitle.Size = UDim2.new(1, 0, 0, 60)
resultsTitle.TextSize = 22
local resultsBody = text(results, "Body", 16, Enum.Font.GothamBold)
resultsBody.Position = UDim2.fromOffset(24, 64)
resultsBody.Size = UDim2.new(1, -48, 1, -80)
resultsBody.TextXAlignment = Enum.TextXAlignment.Left
resultsBody.TextYAlignment = Enum.TextYAlignment.Top

-- Leaderboard (top-right, 230 px): survivors by mass; ♥ lives; 👑 leader; your row adds detail.
local board = Instance.new("Frame")
board.Name = "Leaderboard"
board.AnchorPoint = Vector2.new(1, 0)
board.Position = UDim2.new(1, -16, 0, 16)
board.Size = UDim2.fromOffset(250, 40)
board.AutomaticSize = Enum.AutomaticSize.Y
board.BackgroundColor3 = PANEL
board.BackgroundTransparency = 0.25
board.Parent = gui
corner(board, 10)
local boardPad = Instance.new("UIPadding")
boardPad.PaddingTop = UDim.new(0, 8)
boardPad.PaddingBottom = UDim.new(0, 8)
boardPad.PaddingLeft = UDim.new(0, 10)
boardPad.PaddingRight = UDim.new(0, 10)
boardPad.Parent = board
local boardList = Instance.new("UIListLayout")
boardList.Padding = UDim.new(0, 4)
boardList.SortOrder = Enum.SortOrder.LayoutOrder
boardList.Parent = board
local SLOT = {
	Color3.fromHex("ffb347"), Color3.fromHex("5ec8ff"), Color3.fromHex("ff6b8a"),
	Color3.fromHex("8be07a"), Color3.fromHex("c89bff"), Color3.fromHex("f5f07a"),
}
local function renderBoard(rows: { any })
	for _, c in board:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, r in rows do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, if r.userId == player.UserId then 34 else 18)
		row.LayoutOrder = i
		row.Parent = board
		local chip = Instance.new("Frame")
		chip.BackgroundColor3 = SLOT[(r.slot - 1) % #SLOT + 1]
		chip.BorderSizePixel = 0
		chip.Position = UDim2.fromOffset(14, 5)
		chip.Size = UDim2.fromOffset(8, 8)
		chip.Parent = row
		local rank = text(row, "Rank", 12, Enum.Font.GothamBold, DIM)
		rank.Text = tostring(i)
		rank.Size = UDim2.fromOffset(12, 18)
		local name = text(row, "Name", 13, Enum.Font.GothamBold)
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.Position = UDim2.fromOffset(28, 0)
		name.Size = UDim2.new(1, -110, 0, 18)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		name.Text = (if i == 1 then "👑 " else "") .. r.name .. (if r.userId == player.UserId then " (you)" else "")
		local v, u = Growth.massText(r.mass)
		local mass = text(row, "Mass", 13, Enum.Font.GothamBlack)
		mass.TextXAlignment = Enum.TextXAlignment.Right
		mass.AnchorPoint = Vector2.new(1, 0)
		mass.Position = UDim2.new(1, 0, 0, 0)
		mass.Size = UDim2.fromOffset(80, 18)
		mass.Text = string.rep("♥", r.lives) .. "  " .. v .. " " .. u
		mass.TextColor3 = if r.userId == player.UserId then ORANGE else Color3.new(1, 1, 1)
		if r.userId == player.UserId then
			local extra = text(row, "Extra", 11, Enum.Font.Gotham, DIM)
			extra.TextXAlignment = Enum.TextXAlignment.Left
			extra.Position = UDim2.fromOffset(28, 17)
			extra.Size = UDim2.new(1, -28, 0, 14)
			extra.Text = string.format("ate %d · %s%s", r.objects, string.upper(string.sub(r.look, 1, 1)) .. string.sub(r.look, 2), if not r.alive then " · out" else "")
		end
		if not r.alive then
			for _, l in row:GetDescendants() do
				if l:IsA("TextLabel") then
					l.TextTransparency = 0.55
				end
			end
		end
	end
end

-- Kill feed (right side, under the leaderboard): at most 5 lines, 5 s each.
local feedFrame = Instance.new("Frame")
feedFrame.Name = "Feed"
feedFrame.BackgroundTransparency = 1
feedFrame.AnchorPoint = Vector2.new(1, 0)
feedFrame.Position = UDim2.new(1, -16, 0, 200)
feedFrame.Size = UDim2.fromOffset(320, 140)
feedFrame.Parent = gui
local feedList = Instance.new("UIListLayout")
feedList.Padding = UDim.new(0, 4)
feedList.HorizontalAlignment = Enum.HorizontalAlignment.Right
feedList.SortOrder = Enum.SortOrder.LayoutOrder
feedList.Parent = feedFrame
local feedOrder = 0
local TONES = { kill = Color3.fromRGB(255, 90, 90), bonus = ORANGE, bad = Color3.fromRGB(255, 120, 180), info = Color3.fromRGB(200, 200, 210) }
local function addFeed(s: string, tone: string?)
	feedOrder += 1
	local l = text(feedFrame, "Line", 13, Enum.Font.GothamBold)
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, 22)
	l.BackgroundTransparency = 0.3
	l.BackgroundColor3 = PANEL
	l.Text = "  " .. s .. "  "
	l.LayoutOrder = feedOrder
	local stroke = Instance.new("UIStroke")
	stroke.Color = TONES[tone or "info"] or TONES.info
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = l
	corner(l, 6)
	local lines = {}
	for _, c in feedFrame:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(lines, c)
		end
	end
	table.sort(lines, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #lines > 5 do
		(table.remove(lines, 1) :: TextLabel):Destroy()
	end
	task.delay(5, function()
		l:Destroy()
	end)
end

-- Minimap (184 px, north-up, refreshed every 90 ms; arena/ArenaUi.ts): class ≥ 6 objects and
-- landmark parts (green = you can eat it, landmark orange, grey while locked), crates as dots,
-- machines as slot-colour dots (red ring = can eat you, green = you can eat it, white = you).
local MAP = 184
local minimap = Instance.new("Frame")
minimap.Name = "Minimap"
minimap.AnchorPoint = Vector2.new(1, 1)
minimap.Position = UDim2.new(1, -20, 1, -46)
minimap.Size = UDim2.fromOffset(MAP, MAP)
minimap.BackgroundColor3 = PANEL
minimap.BackgroundTransparency = 0.35
minimap.ClipsDescendants = true
minimap.Parent = gui
corner(minimap, 10)
local mapPool: { Frame } = {}
local mapUsed = 0
local function mapDot(): Frame
	mapUsed += 1
	local f = mapPool[mapUsed]
	if not f then
		local nf = Instance.new("Frame")
		nf.BorderSizePixel = 0
		nf.AnchorPoint = Vector2.new(0.5, 0.5)
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Ring"
		stroke.Thickness = 2
		stroke.Parent = nf
		local c = Instance.new("UICorner")
		c.Name = "Round"
		c.Parent = nf
		nf.Parent = minimap
		mapPool[mapUsed] = nf
		f = nf
	end
	f.Visible = true
	return f
end
local mapCity: any = nil
local mapCityId = ""
local function drawMinimap()
	local arena = workspace:FindFirstChild("Arena")
	local cityId = arena and arena:GetAttribute("City") :: string?
	if not cityId then
		minimap.Visible = false
		return
	end
	minimap.Visible = true
	if cityId ~= mapCityId then
		mapCityId = cityId
		mapCity = require(Shared:WaitForChild("Cities"):WaitForChild(cityId)) :: any
	end
	local b = mapCity.bounds
	local pad = 6
	local k = (MAP - pad * 2) / math.max(b.maxX - b.minX, b.maxZ - b.minZ)
	local function at(x: number, z: number): UDim2
		return UDim2.fromOffset(pad + (x - b.minX) * k, pad + (z - b.minZ) * k)
	end
	mapUsed = 0
	local myD = player:GetAttribute("Diameter") :: number? or WebConfig.growth.startDiameter
	local open = workspace:GetAttribute("LandmarkOpen") == true
	local objects = arena and arena:FindFirstChild("Objects")
	if objects then
		for _, m in objects:GetChildren() do
			local typeId = m:GetAttribute("Type") :: string?
			local def = typeId and WebConfig.objects[typeId]
			if def and m:GetAttribute("State") ~= "pulled" then
				local x, z = m:GetAttribute("X") :: number? or 0, m:GetAttribute("Z") :: number? or 0
				if def.power or def.bonus then
					local f = mapDot()
					f.Size = UDim2.fromOffset(4, 4)
					f.Rotation = 0
					f.BackgroundColor3 = if def.power == "speed" then Color3.fromHex("3fa9ff") elseif def.power == "magnet" then Color3.fromHex("b05cff") elseif def.power == "shield" then Color3.fromHex("3fe0c0") else Color3.fromHex("ffd35a")
					f.BackgroundTransparency = 0
					f.Position = at(x, z)
					;(f:FindFirstChild("Ring") :: UIStroke).Enabled = false
					;(f:FindFirstChild("Round") :: UICorner).CornerRadius = UDim.new(1, 0)
				elseif def.objectClass >= 6 or def.climax then
					local edible = myD >= Growth.requiredPower(typeId :: string) and (open or not def.climax) and m:GetAttribute("Anchored") ~= true
					local f = mapDot()
					f.Size = UDim2.fromOffset(math.max(2, def.size[1] * k), math.max(2, def.size[3] * k))
					f.Rotation = -math.deg(m:GetAttribute("Yaw") :: number? or 0)
					f.Position = at(x, z)
					;(f:FindFirstChild("Ring") :: UIStroke).Enabled = false
					;(f:FindFirstChild("Round") :: UICorner).CornerRadius = UDim.new(0, 0)
					if def.climax then
						f.BackgroundColor3 = if edible then ORANGE elseif not open then Color3.fromRGB(170, 176, 186) else ORANGE
						f.BackgroundTransparency = if edible then 0 elseif not open then 0.5 else 0.45
					else
						f.BackgroundColor3 = if edible then Color3.fromRGB(140, 224, 122) else Color3.fromRGB(210, 214, 220)
						f.BackgroundTransparency = if edible then 0.45 elseif def.objectClass >= 7 then 0.66 else 0.82
					end
				end
			end
		end
	end
	local machines = workspace:FindFirstChild("Machines")
	local myId = tostring(player:GetAttribute("ActorId"))
	if machines then
		for _, m in machines:GetChildren() do
			local root = m:FindFirstChild("Root") :: BasePart?
			if root then
				local p = root.Position / 10
				local d = root:GetAttribute("Diameter") :: number? or 0.35
				local slot = root:GetAttribute("Slot") :: number? or 1
				local f = mapDot()
				f.Size = UDim2.fromOffset(9, 9)
				f.Rotation = 0
				f.BackgroundColor3 = SLOT[(slot - 1) % #SLOT + 1]
				f.BackgroundTransparency = 0
				f.Position = at(p.X, p.Z)
				;(f:FindFirstChild("Round") :: UICorner).CornerRadius = UDim.new(1, 0)
				local ring = f:FindFirstChild("Ring") :: UIStroke
				ring.Enabled = true
				if m.Name == myId then
					ring.Color = Color3.new(1, 1, 1)
				elseif d >= myD * WebConfig.arena.eatRatio then
					ring.Color = Color3.fromRGB(255, 70, 70)
				elseif myD >= d * WebConfig.arena.eatRatio then
					ring.Color = Color3.fromRGB(110, 230, 110)
				else
					ring.Enabled = false
				end
			end
		end
	end
	for i = mapUsed + 1, #mapPool do
		mapPool[i].Visible = false
	end
end
task.spawn(function()
	while true do
		drawMinimap()
		task.wait(0.09)
	end
end)

-- Vehicle picker (between rounds, like the web lobby's "Pick a vehicle" with stat bars).
local PickEvent = remotes:WaitForChild("PickVehicle") :: RemoteEvent
local picker = Instance.new("Frame")
picker.Name = "VehiclePicker"
picker.AnchorPoint = Vector2.new(0.5, 1)
picker.Position = UDim2.new(0.5, 0, 1, -24)
picker.Size = UDim2.fromOffset(4 * 150 + 3 * 10, 150)
picker.BackgroundTransparency = 1
picker.Visible = false
picker.Parent = gui
local pickerList = Instance.new("UIListLayout")
pickerList.FillDirection = Enum.FillDirection.Horizontal
pickerList.Padding = UDim.new(0, 10)
pickerList.Parent = picker
local pickerTitle = text(picker, "Title", 14, Enum.Font.GothamBlack, ORANGE)
pickerTitle.Text = "PICK A VEHICLE"
pickerTitle.Position = UDim2.fromOffset(0, -24)
pickerTitle.Size = UDim2.new(1, 0, 0, 20)
pickerTitle.AnchorPoint = Vector2.new(0, 0)
local cards: { [string]: Frame } = {}
local STATS = { { "speed", "Speed" }, { "accel", "Accel" }, { "reach", "Reach" }, { "pull", "Pull" } }
for _, look in { "collector", "dozer", "racer", "magnet" } do
	local v = WebConfig.vehicles[look]
	local card = Instance.new("TextButton")
	card.Name = look
	card.AutoButtonColor = true
	card.Text = ""
	card.Size = UDim2.fromOffset(150, 150)
	card.BackgroundColor3 = PANEL
	card.BackgroundTransparency = 0.15
	card.Parent = picker
	corner(card, 10)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Selected"
	stroke.Color = ORANGE
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card
	local title = text(card, "Name", 16, Enum.Font.GothamBlack)
	title.Text = string.upper(v.name)
	title.Position = UDim2.fromOffset(0, 8)
	title.Size = UDim2.new(1, 0, 0, 20)
	local blurb = text(card, "Blurb", 11, Enum.Font.Gotham, DIM)
	blurb.Text = v.blurb
	blurb.TextWrapped = true
	blurb.Position = UDim2.fromOffset(8, 28)
	blurb.Size = UDim2.new(1, -16, 0, 28)
	for i, st in STATS do
		local y = 60 + (i - 1) * 20
		local lab = text(card, "L" .. i, 11, Enum.Font.GothamBold, DIM)
		lab.Text = st[2]
		lab.TextXAlignment = Enum.TextXAlignment.Left
		lab.Position = UDim2.fromOffset(10, y)
		lab.Size = UDim2.fromOffset(50, 16)
		local track = Instance.new("Frame")
		track.BackgroundColor3 = Color3.fromRGB(60, 60, 66)
		track.BorderSizePixel = 0
		track.Position = UDim2.fromOffset(58, y + 6)
		track.Size = UDim2.fromOffset(80, 5)
		track.Parent = card
		local fillBar = Instance.new("Frame")
		fillBar.BackgroundColor3 = ORANGE
		fillBar.BorderSizePixel = 0
		-- 0.7 … 1.4 maps to the bar (the four vehicles' range).
		fillBar.Size = UDim2.fromScale(math.clamp((v[st[1]] - 0.7) / 0.7, 0.08, 1), 1)
		fillBar.Parent = track
	end
	card.Activated:Connect(function()
		PickEvent:FireServer(look)
	end)
	cards[look] = card :: any
end
local function refreshPicker()
	local mine = player:GetAttribute("Look") :: string?
	for look, card in cards do
		(card:FindFirstChild("Selected") :: UIStroke).Enabled = look == mine
	end
end
player:GetAttributeChangedSignal("Look"):Connect(refreshPicker)
refreshPicker()

-- Mass panel refresh ----------------------------------------------------------------------------
local shownMass = 0
local function refreshMass()
	local mass = player:GetAttribute("Mass") :: number? or WebConfig.growth.startMass
	local value, unit = Growth.massText(mass)
	massNumber.Text = string.format('%s <font size="16">%s</font>', value, string.upper(unit))
	massNumber.RichText = true
	local cls = Growth.classForPower(Growth.diameterForMass(mass))
	local tier = Growth.tierForClass(cls)
	tierChip.Text = "TIER " .. tier
	tierName.Text = string.upper(Growth.tierName(tier))
	local nextCls, nextMass, frac = Growth.progress(mass)
	fill.Size = UDim2.fromScale(frac, 1)
	if nextCls and nextMass then
		local nv, nu = Growth.massText(nextMass)
		nextLine.Text = string.format('NEXT · <font color="#ffb347">%s</font> · %s %s', string.upper(Growth.classLabel(nextCls)), nv, nu)
	else
		nextLine.Text = "MAX SIZE"
	end
	shownMass = mass
end
player:GetAttributeChangedSignal("Mass"):Connect(refreshMass)
refreshMass()

local gainToken = 0
local function popGain(gain: number)
	gainToken += 1
	local mine = gainToken
	local v, u = Growth.massText(gain)
	massGain.Text = "+" .. v .. " " .. u
	massGain.Position = UDim2.fromOffset(0, -22)
	massGain.TextTransparency = 0
	TweenService:Create(massGain, TweenInfo.new(0.7), { Position = UDim2.fromOffset(0, -40), TextTransparency = 1 }):Play()
	massNumber.TextSize = 39
	TweenService:Create(massNumber, TweenInfo.new(0.16), { TextSize = 34 }):Play()
	task.delay(0.8, function()
		if gainToken == mine then
			massGain.TextTransparency = 1
		end
	end)
end

-- Events -----------------------------------------------------------------------------------
local comboText = ""
local comboUntil = 0
AbsorbedEvent.OnClientEvent:Connect(function(info: { [string]: any })
	popGain(info.gain)
	Feel.absorb(info.cls, info.size)
	-- Pop at the intake; big objects (class ≥ 3) burst and shake by size relative to the machine.
	local machines = workspace:FindFirstChild("Machines")
	local m = machines and machines:FindFirstChild(tostring(player:GetAttribute("ActorId")))
	local root = m and m:FindFirstChild("Root") :: BasePart?
	if root then
		local d = root:GetAttribute("Diameter") :: number? or 0.35
		local intake = root.CFrame * CFrame.new(0, 0, -d * 0.3 * 10)
		if info.cls >= 3 then
			Feel.burst(intake.Position, ORANGE, 12, math.max(0.2, d * 2))
			Feel.trauma(WebConfig.feel.largePickupTrauma * math.min(1, info.size / d))
		else
			Feel.burst(intake.Position, Color3.new(1, 1, 1), 4, math.max(0.1, d))
		end
	end
	if info.combo then
		comboText = string.format("Combo ×%.1f", info.combo)
		comboUntil = os.clock() + WebConfig.arena.comboWindow
	end
	if info.power == "speed" then
		showToast("⚡ Speed " .. WebConfig.arena.speedSeconds .. "s", Color3.fromHex("3fa9ff"))
	elseif info.power == "magnet" then
		showToast("🧲 Magnet " .. WebConfig.arena.magnetSeconds .. "s", Color3.fromHex("b05cff"))
	elseif info.power == "shield" then
		showToast("🛡 Shield " .. WebConfig.arena.shieldSeconds .. "s", Color3.fromHex("3fe0c0"))
	end
end)

NoticeEvent.OnClientEvent:Connect(function(n: { [string]: any })
	if n.kind == "unlock" then
		Feel.play("unlock")
		showBanner("UNLOCKED: " .. string.upper(Growth.classLabel(n.cls)), "SIZE CLASS " .. n.cls, 1.6)
	elseif n.kind == "tier" then
		Feel.play("tier")
		Feel.pullBack(0.28, 1.6)
		Feel.trauma(WebConfig.feel.tierUpTrauma)
		showBanner("TIER " .. n.tier, "NOW EATING: " .. string.upper(Growth.classLabel(n.cls)), 2.4)
	elseif n.kind == "landmarkOpen" then
		local t = CITY_TEXT[n.city]
		Feel.play("unlock")
		showBanner("LANDMARK OPEN!", "TOPPLE THE " .. string.upper(t and t.landmark or "LANDMARK"), 2.6)
	elseif n.kind == "landmarkDown" then
		local t = CITY_TEXT[n.city]
		Feel.play("landmark")
		Feel.pullBack(0.35, 2.6)
		showBanner(string.upper(t and t.landmark or "LANDMARK") .. " DOWN!", n.name .. " · LANDMARK BONUS +25%", 3)
	elseif n.kind == "ate" then
		Feel.play("burp")
		Feel.trauma(0.5)
		local v, u = Growth.massText(n.gain)
		showBanner("ATE " .. string.upper(n.name) .. "!", "+" .. v .. " " .. string.upper(u) .. (if n.first then " · FIRST BLOOD" else ""), 2)
	elseif n.kind == "eaten" then
		Feel.play("eaten")
		Feel.trauma(0.7)
		if n.lives and n.lives <= 0 then
			showBanner("ELIMINATED", "Eaten by " .. n.name .. " · spectating", 3)
		else
			showBanner("YOU GOT EATEN", "Eaten by " .. n.name .. " · " .. tostring(n.lives) .. " lives left", 2.4)
			center.Text = tostring(WebConfig.arena.respawnDelay)
			centerSub.Text = "RESPAWNING"
			for t = WebConfig.arena.respawnDelay - 1, 1, -1 do
				task.delay(WebConfig.arena.respawnDelay - t, function()
					if centerSub.Text == "RESPAWNING" then
						center.Text = tostring(t)
					end
				end)
			end
		end
	elseif n.kind == "respawn" then
		center.Text = ""
		centerSub.Text = ""
		showToast("RESPAWN · " .. WebConfig.arena.invulnerableSeconds .. " s INVULNERABLE")
	elseif n.kind == "crash" then
		showToast(n.text, Color3.fromRGB(255, 120, 120))
		addFeed("Dashed into something too big: stunned, mass lost", "bad")
	elseif n.kind == "feed" then
		addFeed(n.text, n.tone)
	end
end)

local function fmt(seconds: number): string
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local lastPhase = ""
RoundEvent.OnClientEvent:Connect(function(msg: { [string]: any })
	local p = msg.phase
	local t = CITY_TEXT[msg.city or ""]
	local cityLine = if t then string.format("%s · %s %d/%d", t.city, t.landmark, msg.climaxEaten or 0, msg.climaxTotal or 0) else ""
	results.Visible = p == "Results"
	picker.Visible = p == "Intermission" or p == "Waiting"
	if msg.board then
		renderBoard(msg.board)
	end
	if p == "Intermission" then
		timer.Text = fmt(msg.timeLeft)
		subline.Text = "Next round in " .. tostring(msg.timeLeft) .. " · " .. (if t then t.city else "")
		lockLine.Text = "Drive around — eating starts with the round"
		center.Text = ""
		centerSub.Text = ""
	elseif p == "Waiting" then
		timer.Text = ""
		subline.Text = "Waiting for players…"
		lockLine.Text = ""
	elseif p == "Countdown" then
		Feel.play("beep_low")
		center.Text = tostring(msg.timeLeft)
		centerSub.Text = "GET READY"
		timer.Text = fmt(WebConfig.arena.roundSeconds)
		subline.Text = cityLine
		lockLine.Text = ""
	elseif p == "Round" then
		timer.Text = fmt(msg.timeLeft)
		subline.Text = cityLine
		if msg.go then
			Feel.play("beep_high")
			center.Text = "GO"
			centerSub.Text = "EAT!"
			task.delay(1.2, function()
				if center.Text == "GO" then
					center.Text = ""
					centerSub.Text = ""
				end
			end)
		end
		if msg.landmarkIn and msg.landmarkIn > 0 then
			lockLine.Text = "🔒 Landmark opens in " .. fmt(msg.landmarkIn)
		elseif msg.landmarkIn == 0 and lastPhase == "Round" then
			lockLine.Text = if workspace:GetAttribute("LandmarkOpen") then "🔓 Topple it now!" else ""
		end
	elseif p == "Results" then
		center.Text = ""
		centerSub.Text = ""
		lockLine.Text = ""
		local rows = msg.rows or {}
		local champion = rows[1]
		if champion and champion.userId == player.UserId then
			Feel.play("win")
		end
		resultsTitle.Text = "Round over"
		local lines = {}
		if champion then
			local v, u = Growth.massText(champion.mass)
			resultsTitle.Text = "👑 Champion · " .. champion.name .. " · " .. v .. " " .. u
		end
		table.insert(lines, "#   Player            Mass        Eats  Eaten  Items")
		for i, r in rows do
			local v, u = Growth.massText(r.mass)
			table.insert(lines, string.format("%d   %-16s  %8s %-2s  %4d  %5d  %5d%s", i, string.sub(r.name, 1, 16), v, u, r.kills, r.deaths, r.objects, if r.alive then "" else " · out"))
			if i >= 8 then
				break
			end
		end
		if msg.awards and #msg.awards > 0 then
			table.insert(lines, "")
			for _, a in msg.awards do
				table.insert(lines, a)
			end
		end
		resultsBody.Text = table.concat(lines, "\n")
		resultsBody.Font = Enum.Font.RobotoMono
		resultsBody.TextSize = 14
	end
	lastPhase = p
end)

-- Combo and power-up timers.
RunService.Heartbeat:Connect(function()
	local lines = {}
	if os.clock() < comboUntil and comboText ~= "" then
		table.insert(lines, comboText)
	end
	local machines = workspace:FindFirstChild("Machines")
	local m = machines and machines:FindFirstChild(tostring(player:GetAttribute("ActorId")))
	local root = m and m:FindFirstChild("Root")
	if root then
		local t = workspace:GetServerTimeNow()
		for _, p in { { "SpeedUntil", "⚡ Speed" }, { "MagnetUntil", "🧲 Magnet" }, { "ShieldUntil", "🛡 Shield" } } do
			local untilT = root:GetAttribute(p[1]) :: number? or 0
			if untilT > t then
				table.insert(lines, string.format("%s %ds", p[2], math.ceil(untilT - t)))
			end
		end
	end
	status.Text = table.concat(lines, "\n")
	local _ = shownMass
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="31">
          <Properties>
            <string name="Name">Play</string>
            <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox) client: the web arena's play feel.
--  * Drives the local machine with the web movement rules (ArenaGame.moveActor): top speed,
--    acceleration and turn rate from mass and vehicle, SPACE dash, camera-relative WASD.
--  * Collides like the web World: circle vs static boxes and vs objects too big to eat.
--  * Claims eligible objects within reach (the server checks and pulls them in).
--  * Follow camera = web CameraRig (distance/height/look-ahead/FOV per metre, drag to look,
--    auto-align behind after 1.2 s).
--  * Draws every machine with the web machine model of its tier, easing size like the web.
-- World units are metres; × STUDS_PER_METER for Roblox.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local WebConfig = require(Shared:WaitForChild("WebConfig"))
local Growth = require(Shared:WaitForChild("Growth"))
local Collision = require(Shared:WaitForChild("Collision"))
local Movement = require(Shared:WaitForChild("Movement"))
local Feel = require(script.Parent:WaitForChild("Feel"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local ClaimEvent = remotes:WaitForChild("Claim") :: RemoteEvent
local CrashEvent = remotes:WaitForChild("Crash") :: RemoteEvent
local templates = ReplicatedStorage:WaitForChild("ModelTemplates")

local K = Config.STUDS_PER_METER
local CC = WebConfig.collection
local CAM = WebConfig.camera
local A = WebConfig.arena
local G = WebConfig.growth
local OBJECTS = WebConfig.objects

local camera = workspace.CurrentCamera
camera.CameraType = Enum.CameraType.Scriptable

local function now(): number
	return workspace:GetServerTimeNow()
end

-- City data -------------------------------------------------------------------------------------
type Rec = { id: number, model: Model, type: string, def: any, req: number, radius: number, x: number, y: number, z: number, yaw: number, state: string, anchored: boolean }
-- The local machine: its root and the movement body driven by Movement.step.
local me = { root = nil :: BasePart?, body = Movement.new(0, 0, 0) }
local recs: { [number]: Rec } = {}
local cells: { [number]: { Rec } } = {}
local CELL = 8
local city: any = nil
local ground = function(_x: number, _z: number): number
	return 0
end

local function cellKey(cx: number, cz: number): number
	return (cx + 4096) * 8192 + (cz + 4096)
end
local function addToGrid(r: Rec)
	local k = cellKey(math.floor(r.x / CELL), math.floor(r.z / CELL))
	local list = cells[k]
	if not list then
		list = {}
		cells[k] = list
	end
	table.insert(list, r)
end
local nearBuf: { Rec } = {}
local nearStamp: { [Rec]: number } = {}
local stamp = 0
local function near(x: number, z: number, r: number): { Rec }
	table.clear(nearBuf)
	stamp += 1
	for cx = math.floor((x - r - 6) / CELL), math.floor((x + r + 6) / CELL) do
		for cz = math.floor((z - r - 6) / CELL), math.floor((z + r + 6) / CELL) do
			local list = cells[cellKey(cx, cz)]
			if list then
				for _, rec in list do
					if nearStamp[rec] ~= stamp and recs[rec.id] == rec then
						nearStamp[rec] = stamp
						table.insert(nearBuf, rec)
					end
				end
			end
		end
	end
	return nearBuf
end

local function track(m: Instance)
	if not m:IsA("Model") then
		return
	end
	local id = m:GetAttribute("Id") :: number?
	local typeId = m:GetAttribute("Type") :: string?
	if not id or not typeId then
		return
	end
	local def = OBJECTS[typeId]
	local r: Rec = {
		id = id,
		model = m,
		type = typeId,
		def = def,
		req = Growth.requiredPower(typeId),
		radius = math.sqrt((def.size[1] / 2) ^ 2 + (def.size[3] / 2) ^ 2),
		x = m:GetAttribute("X") :: number? or 0,
		y = m:GetAttribute("Y") :: number? or 0,
		z = m:GetAttribute("Z") :: number? or 0,
		yaw = m:GetAttribute("Yaw") :: number? or 0,
		state = m:GetAttribute("State") :: string? or "idle",
		anchored = m:GetAttribute("Anchored") == true,
	}
	recs[id] = r
	addToGrid(r)
	m.AttributeChanged:Connect(function(name)
		if name == "State" then
			local before = r.state
			r.state = m:GetAttribute("State") :: string? or "idle"
			local size = math.max(r.def.size[1], r.def.size[2], r.def.size[3])
			local pos = Vector3.new(r.x, r.y + r.def.size[2] / 2, r.z) * K
			local cls = r.def.objectClass
			if r.state == "pulled" and cls >= 4 then
				-- Destruction beat (ArenaGame.startPull): shards, dust, sparks for crush/collapse.
				local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
				Feel.shards(pos, if pp then pp.Color else Color3.new(0.6, 0.6, 0.6), 12, math.max(0.3, size * 0.09 * K), (2 + size * 0.9) * K)
				Feel.dust(Vector3.new(r.x, r.y, r.z) * K, size * 0.5 * K, if cls >= 6 then 6 else 3)
				if r.def.destructionType == "crush" or r.def.destructionType == "collapse" then
					Feel.sparks(Vector3.new(r.x, r.y + r.def.size[2] * 0.8, r.z) * K, 10, (1.5 + size * 0.6) * K)
				end
				if m:GetAttribute("Owner") == player:GetAttribute("ActorId") then
					Feel.crunch(cls)
					local myD = me.root and me.root:GetAttribute("Diameter") :: number? or G.startDiameter
					local rel = math.min(1.5, size / myD)
					Feel.trauma(math.min(0.45, (0.08 + 0.035 * cls) * math.min(1, 0.25 + 0.6 * rel)))
				end
			elseif before == "falling" and r.state == "idle" then
				-- A landmark part landing: dust and a rumble that fades with distance.
				Feel.dust(Vector3.new(r.x, r.y, r.z) * K, size * 0.6 * K, 12)
				local dist = math.sqrt((r.x - me.body.x) ^ 2 + (r.z - me.body.z) ^ 2)
				if dist < (45 + size * 3) * 2 then
					Feel.play("collapse")
					Feel.traumaAt(math.min(0.5, 0.12 + size * 0.02), dist, size)
				end
			end
		elseif name == "Anchored" then
			r.anchored = m:GetAttribute("Anchored") == true
		elseif name == "X" or name == "Z" or name == "Y" or name == "Yaw" then
			r.x = m:GetAttribute("X") :: number? or r.x
			r.y = m:GetAttribute("Y") :: number? or r.y
			r.z = m:GetAttribute("Z") :: number? or r.z
			r.yaw = m:GetAttribute("Yaw") :: number? or r.yaw
			addToGrid(r)
		end
	end)
end

local function bindArena(arena: Instance)
	table.clear(recs)
	table.clear(cells)
	local cityId = arena:GetAttribute("City") :: string?
	if cityId then
		city = require(Shared:WaitForChild("Cities"):WaitForChild(cityId)) :: any
		ground = Collision.groundLookup(city.ground)
	end
	local objects = arena:WaitForChild("Objects")
	for _, m in objects:GetChildren() do
		track(m)
	end
	objects.ChildAdded:Connect(track)
	objects.ChildRemoved:Connect(function(m)
		local id = m:GetAttribute("Id") :: number?
		if id and recs[id] and recs[id].model == m then
			recs[id] = nil
		end
	end)
end
workspace.ChildAdded:Connect(function(c)
	if c.Name == "Arena" then
		bindArena(c)
	end
end)
if workspace:FindFirstChild("Arena") then
	task.spawn(bindArena, workspace:FindFirstChild("Arena") :: Instance)
end

local function landmarkOpen(): boolean
	return workspace:GetAttribute("LandmarkOpen") == true
end
local function phase(): string
	return workspace:GetAttribute("Phase") :: string? or "Loading"
end
local function eligible(r: Rec, power: number): boolean
	if r.state ~= "idle" or r.anchored then
		return false
	end
	if r.def.climax and not landmarkOpen() then
		return false
	end
	return power >= r.req
end
local function solid(r: Rec, power: number): boolean
	if r.state ~= "idle" then
		return false
	end
	if r.y > ground(r.x, r.z) + 2.5 then
		return false
	end
	return r.anchored or not eligible(r, power)
end
local function box(r: Rec): Collision.Box
	return { r.x, r.z, r.def.size[1] / 2, r.def.size[3] / 2, r.yaw }
end

-- Machine visuals (every machine, drawn locally) -------------------------------------------------
type Visual = { model: Model?, tier: number, base: number, shown: number, lastScale: number }
local visuals: { [BasePart]: Visual } = {}
local visualFolder = Instance.new("Folder")
visualFolder.Name = "MachineVisuals"
visualFolder.Parent = workspace

local function updateVisual(root: BasePart, dt: number)
	local v = visuals[root]
	local target = root:GetAttribute("Diameter") :: number? or G.startDiameter
	if not v then
		v = { model = nil, tier = 0, base = 1, shown = target, lastScale = 0 }
		visuals[root] = v
	end
	v.shown += (target - v.shown) * (1 - math.exp(-G.visualGrowthRate * dt))
	local tier = Growth.tierForClass(Growth.classForPower(target))
	if tier ~= v.tier or not v.model then
		local look = root:GetAttribute("Look") :: string? or "collector"
		local template = templates:FindFirstChild(string.format("Machine_%s_T%d", look, tier)) :: Model?
		if template then
			if v.model then
				v.model:Destroy()
			end
			local m = template:Clone()
			v.model = m
			v.tier = tier
			v.base = m:GetScale()
			v.lastScale = 0
			m.Parent = visualFolder
		end
	end
	local m = v.model
	if m then
		if math.abs(v.shown - v.lastScale) / math.max(v.lastScale, 1e-3) > 0.004 then
			v.lastScale = v.shown
			m:ScaleTo(v.base * v.shown)
		end
		m:PivotTo(root.CFrame * CFrame.new(0, -target * K / 2, 0))
		-- Invulnerable after a respawn: blink at 8 Hz.
		local inv = root:GetAttribute("InvulnerableUntil") :: number?
		local hidden = inv ~= nil and now() < inv and math.floor(os.clock() * 16) % 2 == 0
		m.Parent = if hidden then nil else visualFolder
	end
end

local function cleanupVisuals()
	for root, v in visuals do
		if not root.Parent then
			if v.model then
				v.model:Destroy()
			end
			visuals[root] = nil
		end
	end
end

-- Local machine --------------------------------------------------------------------------------
local cam = { yaw = 0, pitch = 1, idle = 0, pos = nil :: Vector3?, fov = CAM.fovBase }

local function myRoot(): BasePart?
	local machines = workspace:FindFirstChild("Machines")
	local m = machines and machines:FindFirstChild(tostring(player:GetAttribute("ActorId")))
	local root = m and m:FindFirstChild("Root") :: BasePart?
	return root
end

local keys: { [Enum.KeyCode]: boolean } = {}
local dashPressed = false
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Space then
		dashPressed = true
	end
	keys[input.KeyCode] = true
end)
UserInputService.InputEnded:Connect(function(input)
	keys[input.KeyCode] = false
end)
-- Drag to look (any mouse button), like the web game.
local dragging = false
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2) then
		dragging = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
		dragging = false
	end
end)
UserInputService.InputChanged:Connect(function(input: InputObject)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		cam.yaw -= input.Delta.X * CAM.mouseYawPerPixel
		cam.pitch = math.clamp(cam.pitch + input.Delta.Y * CAM.mousePitchPerPixel, 0.45, 1.8)
		cam.idle = 0
	end
end)

-- Touch (web touch layout): drag on the left half to steer, drag on the right half to look,
-- DASH button bottom-right.
local touchMove = Vector2.zero
local moveTouch: InputObject? = nil
local moveOrigin = Vector2.zero
local lookTouch: InputObject? = nil
if UserInputService.TouchEnabled then
	local touchGui = Instance.new("ScreenGui")
	touchGui.Name = "TouchControls"
	touchGui.ResetOnSpawn = false
	touchGui.Parent = player:WaitForChild("PlayerGui")
	local dash = Instance.new("TextButton")
	dash.Name = "Dash"
	dash.AnchorPoint = Vector2.new(1, 1)
	dash.Position = UDim2.new(1, -28, 1, -200)
	dash.Size = UDim2.fromOffset(84, 84)
	dash.Text = "DASH"
	dash.Font = Enum.Font.GothamBlack
	dash.TextSize = 16
	dash.TextColor3 = Color3.fromRGB(30, 20, 5)
	dash.BackgroundColor3 = Color3.fromHex("ffb347")
	dash.Parent = touchGui
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = dash
	dash.Activated:Connect(function()
		dashPressed = true
	end)
	UserInputService.TouchStarted:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local p = Vector2.new(input.Position.X, input.Position.Y)
		if p.X < camera.ViewportSize.X / 2 and not moveTouch then
			moveTouch = input
			moveOrigin = p
		elseif not lookTouch then
			lookTouch = input
		end
	end)
	UserInputService.TouchMoved:Connect(function(input: InputObject)
		if input == moveTouch then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - moveOrigin
			local r = 70
			touchMove = if delta.Magnitude > r then delta.Unit else delta / r
		elseif input == lookTouch then
			cam.yaw -= input.Delta.X * CAM.mouseYawPerPixel
			cam.pitch = math.clamp(cam.pitch + input.Delta.Y * CAM.mousePitchPerPixel, 0.45, 1.8)
			cam.idle = 0
		end
	end)
	UserInputService.TouchEnded:Connect(function(input: InputObject)
		if input == moveTouch then
			moveTouch = nil
			touchMove = Vector2.zero
		elseif input == lookTouch then
			lookTouch = nil
		end
	end)
end

local function axis(pos: { Enum.KeyCode }, neg: { Enum.KeyCode }): number
	local v = 0
	for _, k in pos do
		if keys[k] then
			v += 1
			break
		end
	end
	for _, k in neg do
		if keys[k] then
			v -= 1
			break
		end
	end
	return v
end

local function vehicle(root: BasePart): any
	return WebConfig.vehicles[root:GetAttribute("Look") :: string? or "collector"]
end

local lastBoing = 0
local function move(root: BasePart, dt: number): number
	local d = root:GetAttribute("Diameter") :: number? or G.startDiameter
	local mass = root:GetAttribute("Mass") :: number? or G.startMass
	local p = phase()
	local frozen = p == "Countdown" or p == "Results" or p == "Loading"
	-- Camera-relative input.
	local ix = axis({ Enum.KeyCode.D, Enum.KeyCode.Right }, { Enum.KeyCode.A, Enum.KeyCode.Left }) + touchMove.X
	local iy = axis({ Enum.KeyCode.W, Enum.KeyCode.Up }, { Enum.KeyCode.S, Enum.KeyCode.Down }) - touchMove.Y
	local fx, fz = -math.sin(cam.yaw), -math.cos(cam.yaw)
	local rx, rz = math.cos(cam.yaw), -math.sin(cam.yaw)
	local wx, wz = fx * iy + rx * ix, fz * iy + rz * ix
	local r = d * 0.47
	local solids: { Movement.Solid } = {}
	for _, o in near(me.body.x, me.body.z, r * 2 + 0.5) do
		if solid(o, d) then
			table.insert(solids, { x = o.x, z = o.z, radius = o.radius, box = box(o) })
		end
	end
	local boosted = now() < (root:GetAttribute("SpeedUntil") :: number? or 0)
	local cooling = me.body.dashCooldown > 0
	local dashBefore = me.body.dashTime
	local top, crashed = Movement.step(me.body, dt, now(), wx, wz, dashPressed, frozen, mass, d, vehicle(root), boosted, city and city.colliders, city and city.bounds, solids)
	dashPressed = false
	if me.body.dashTime > dashBefore then
		-- Dash: whoosh, FOV kick, dust at the wheels.
		Feel.play("dash")
		Feel.kickFov(7)
		Feel.dust(Vector3.new(me.body.x, ground(me.body.x, me.body.z), me.body.z) * K, d * 0.6 * K, 4)
	elseif cooling and me.body.dashCooldown <= 0 then
		Feel.play("dashReady", 0.5)
	end
	if crashed then
		CrashEvent:FireServer()
		Feel.play("stun")
		Feel.trauma(0.35)
		Feel.sparks(Vector3.new(me.body.x, ground(me.body.x, me.body.z) + d * 0.5, me.body.z) * K, 14, (3 + d) * K)
	end
	-- Bumper cars against machines neither side can eat (push only ours; theirs is driven elsewhere).
	local machines = workspace:FindFirstChild("Machines")
	if machines and not frozen then
		local myLook = root:GetAttribute("Look") :: string? or "collector"
		for _, m in machines:GetChildren() do
			local other = m:FindFirstChild("Root") :: BasePart?
			if other and other ~= root then
				local od = other:GetAttribute("Diameter") :: number? or G.startDiameter
				local oLook = other:GetAttribute("Look") :: string? or "collector"
				local t = now()
				local safe = t < (other:GetAttribute("InvulnerableUntil") :: number? or 0) or t < (root:GetAttribute("InvulnerableUntil") :: number? or 0)
				local iEat = d >= od * A.eatRatio * WebConfig.vehicles[myLook].eatRatio and t >= (other:GetAttribute("ShieldUntil") :: number? or 0)
				local theyEat = od >= d * A.eatRatio * WebConfig.vehicles[oLook].eatRatio and t >= (root:GetAttribute("ShieldUntil") :: number? or 0)
				if safe or not (iEat or theyEat) then
					local op = other.Position / K
					if Movement.bump(me.body, d, op.X, op.Z, od, other.AssemblyLinearVelocity.Magnitude / K, 1) and os.clock() - lastBoing > 0.8 then
						lastBoing = os.clock()
						Feel.play("boing")
						Feel.trauma(0.15)
					end
				end
			end
		end
	end
	local y = ground(me.body.x, me.body.z)
	local ap = root:FindFirstChildOfClass("AlignPosition")
	local ao = root:FindFirstChildOfClass("AlignOrientation")
	if ap and ao then
		ap.Position = Vector3.new(me.body.x * K, (y + d / 2) * K, me.body.z * K)
		ao.CFrame = CFrame.Angles(0, me.body.heading, 0)
	end
	return top
end

-- Claims: propose every eligible object within reach (ArenaGame.proposeCollection).
local claimedAt: { [number]: number } = {}
local claimClock = 0
local function claim(root: BasePart, dt: number)
	claimClock += dt
	if claimClock < 0.1 or phase() ~= "Round" then
		return
	end
	claimClock = 0
	local d = root:GetAttribute("Diameter") :: number? or G.startDiameter
	local magnet = if now() < (root:GetAttribute("MagnetUntil") :: number? or 0) then A.magnetMul else 1
	local reach = (d / 2 + d * CC.reachFactor + CC.reachFlat) * vehicle(root).reach * magnet
	local ids = {}
	local t = os.clock()
	for _, o in near(me.body.x, me.body.z, reach * math.max(1, CC.vacuumReachMultiplier)) do
		if eligible(o, d) and (not claimedAt[o.id] or t - claimedAt[o.id] > 1.5) then
			local rr = if o.radius * 2 < d * CC.vacuumSizeRatio then reach * CC.vacuumReachMultiplier else reach
			if math.abs(o.x - me.body.x) <= o.radius + rr and math.abs(o.z - me.body.z) <= o.radius + rr and Collision.circleVsObb(me.body.x, me.body.z, rr, box(o)) then
				claimedAt[o.id] = t
				table.insert(ids, o.id)
			end
		end
	end
	if #ids > 0 then
		ClaimEvent:FireServer(ids)
	end
end

-- Follow camera (web CameraRig) on a machine at (x, z) facing heading.
local function updateCamera(dt: number, x: number, z: number, heading: number, speedRatio: number, d: number)
	cam.idle += dt
	if cam.idle > CAM.autoAlignDelay and speedRatio > 0.25 then
		local diff = math.atan2(math.sin(heading - cam.yaw), math.cos(heading - cam.yaw))
		cam.yaw += diff * math.min(1, CAM.autoAlignRate * speedRatio * dt)
	end
	local g = ground(x, z)
	local dist = CAM.distanceBase + CAM.distancePerMetre * d
	local height = (CAM.heightBase + CAM.heightPerMetre * d) * cam.pitch
	local s, c = math.sin(cam.yaw), math.cos(cam.yaw)
	local look = Vector3.new(x - s * CAM.lookAheadPerMetre * d, g + CAM.lookHeightPerMetre * d + 0.1, z - c * CAM.lookAheadPerMetre * d) * K
	local desired = Vector3.new(x + s * dist, g + height, z + c * dist) * K
	-- Feel: trauma shake, timed pull-back (tier up, landmark), dash FOV kick (systems/Effects.ts).
	local shake, distMul, fovExtra = Feel.camera(dt, dist * K)
	desired = look + (desired - look) * distMul
	local k = 1 - math.exp(-CAM.followSharpness * dt)
	cam.pos = if cam.pos then cam.pos:Lerp(desired, k) else desired
	local fov = math.min(CAM.fovMax, CAM.fovBase + CAM.fovPerMetre * d)
	cam.fov += (fov - cam.fov) * k
	camera.FieldOfView = cam.fov + fovExtra
	camera.CFrame = CFrame.lookAt((cam.pos :: Vector3) + shake, look + shake * 0.5)
end

-- Name tags over other machines: "Name · 1,234 kg" with ⚠ (it can eat you) or ✓ (you can eat it).
local tags: { [BasePart]: BillboardGui } = {}
local function updateTag(root: BasePart, myD: number?)
	local tag = tags[root]
	if not tag then
		local t = Instance.new("BillboardGui")
		tag = t
		t.Name = "NameTag"
		t.Size = UDim2.fromOffset(220, 26)
		t.AlwaysOnTop = true
		t.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.5
		label.Parent = t
		local line = Instance.new("Frame")
		line.Name = "Line"
		line.AnchorPoint = Vector2.new(0.5, 1)
		line.Position = UDim2.fromScale(0.5, 1)
		line.Size = UDim2.new(0.5, 0, 0, 2)
		line.BorderSizePixel = 0
		line.Parent = t
		t.Adornee = root
		t.Parent = visualFolder
		tags[root] = t
	end
	assert(tag)
	local d = root:GetAttribute("Diameter") :: number? or G.startDiameter
	tag.StudsOffset = Vector3.new(0, d * K * 0.9 + 1, 0)
	local mass = root:GetAttribute("Mass") :: number? or G.startMass
	local v, u = Growth.massText(mass)
	local mark = ""
	if myD then
		local look = root:GetAttribute("Look") :: string? or "collector"
		local myLook = me.root and me.root:GetAttribute("Look") :: string? or "collector"
		if d >= myD * A.eatRatio * WebConfig.vehicles[look].eatRatio then
			mark = "  ⚠"
		elseif myD >= d * A.eatRatio * WebConfig.vehicles[myLook].eatRatio then
			mark = "  ✓"
		end
	end
	local label = tag:FindFirstChild("Label") :: TextLabel
	label.Text = string.format("%s · %s %s%s", root:GetAttribute("Name") :: string? or "?", v, u, mark)
	local slot = root:GetAttribute("Slot") :: number? or 1
	local line = tag:FindFirstChild("Line") :: Frame
	line.BackgroundColor3 = Config.SLOT_COLORS[(slot - 1) % #Config.SLOT_COLORS + 1]
end

-- Spectating (eliminated or between lives): follow the biggest machine.
local function leaderRoot(): BasePart?
	local best, bestMass = nil, -1
	local machines = workspace:FindFirstChild("Machines")
	if machines then
		for _, m in machines:GetChildren() do
			local root = m:FindFirstChild("Root") :: BasePart?
			local mass = root and root:GetAttribute("Mass") :: number? or 0
			if root and mass > bestMass then
				best, bestMass = root, mass
			end
		end
	end
	return best
end

RunService.RenderStepped:Connect(function(dt: number)
	dt = math.min(dt, 0.05)
	local root = myRoot()
	local myD = if root then root:GetAttribute("Diameter") :: number? else nil
	local machines = workspace:FindFirstChild("Machines")
	if machines then
		for _, m in machines:GetChildren() do
			local r = m:FindFirstChild("Root") :: BasePart?
			if r then
				updateVisual(r, dt)
				if r ~= root then
					updateTag(r, myD)
				end
			end
		end
	end
	cleanupVisuals()
	for r, tag in tags do
		if not r.Parent then
			tag:Destroy()
			tags[r] = nil
		end
	end
	if root ~= me.root then
		me.root = root
		if root then
			-- New machine (spawn / respawn / new round): take its position and face its way.
			local p = root.Position / K
			local lv = root.CFrame.LookVector
			me.body = Movement.new(p.X, p.Z, math.atan2(-lv.X, -lv.Z))
			cam.yaw = me.body.heading
			cam.pos = nil
		end
	end
	if root and root.Parent then
		local top = move(root, dt)
		claim(root, dt)
		local v = visuals[root]
		updateCamera(dt, me.body.x, me.body.z, me.body.heading, math.abs(me.body.speed) / math.max(top, 1e-3), if v then v.shown else (myD or G.startDiameter))
	else
		local target = leaderRoot()
		if target then
			local p = target.Position / K
			local lv = target.CFrame.LookVector
			local v = visuals[target]
			updateCamera(dt, p.X, p.Z, math.atan2(-lv.X, -lv.Z), 1, if v then v.shown else (target:GetAttribute("Diameter") :: number? or G.startDiameter))
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="32">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
