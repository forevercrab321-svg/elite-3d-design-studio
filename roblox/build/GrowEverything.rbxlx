      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Collision</string>
          <string name="Source"><![CDATA[--!strict
-- The web game's 2D collision (core/collision.ts circleVsObb, World.resolveStatic) and the city
-- ground height grid, in metres. Box = { cx, cz, hx, hz, yaw }.

local Collision = {}

export type Box = { number }

-- Circle (px, pz, r) against an oriented box. Returns the push-out normal and depth, or nil.
function Collision.circleVsObb(px: number, pz: number, r: number, b: Box): (number?, number?, number?)
	local c, s = math.cos(b[5]), math.sin(b[5])
	local dx, dz = px - b[1], pz - b[2]
	local lx = dx * c - dz * s
	local lz = dx * s + dz * c
	local qx = math.clamp(lx, -b[3], b[3])
	local qz = math.clamp(lz, -b[4], b[4])
	local ex, ez = lx - qx, lz - qz
	local d2 = ex * ex + ez * ez
	if d2 >= r * r then
		return nil
	end
	local depth
	if d2 > 1e-10 then
		local d = math.sqrt(d2)
		ex /= d
		ez /= d
		depth = r - d
	else
		-- Centre inside the box: leave through the nearest face.
		local px2 = b[3] - math.abs(lx)
		local pz2 = b[4] - math.abs(lz)
		if px2 < pz2 then
			ex, ez = if lx < 0 then -1 else 1, 0
			depth = px2 + r
		else
			ex, ez = 0, if lz < 0 then -1 else 1
			depth = pz2 + r
		end
	end
	return ex * c + ez * s, -ex * s + ez * c, depth
end

-- Push a circle out of the static boxes (two passes) and keep it inside the bounds.
function Collision.resolveStatic(x: number, z: number, r: number, boxes: { Box }, bounds: { [string]: number }): (number, number, boolean)
	local hit = false
	for _ = 1, 2 do
		for _, b in boxes do
			local nx, nz, depth = Collision.circleVsObb(x, z, r, b)
			if nx then
				x += nx * (depth :: number)
				z += (nz :: number) * (depth :: number)
				hit = true
			end
		end
	end
	x = math.clamp(x, bounds.minX + r, bounds.maxX - r)
	z = math.clamp(z, bounds.minZ + r, bounds.maxZ - r)
	return x, z, hit
end

-- Decode the run-length ground grid ({ x0, z0, rows = { "h*n,h*n" } }) into a height lookup.
function Collision.groundLookup(ground: any): (number, number) -> number
	local rows: { { number } } = {}
	for i, row in ground.rows do
		local cells: { number } = {}
		for h, n in string.gmatch(row, "([%-%d%.]+)%*(%d+)") do
			local v = tonumber(h) :: number
			for _ = 1, tonumber(n) :: number do
				table.insert(cells, v)
			end
		end
		rows[i] = cells
	end
	local x0, z0 = ground.x0, ground.z0
	return function(x: number, z: number): number
		local row = rows[math.floor(z - z0) + 1]
		return row and row[math.floor(x - x0) + 1] or 0
	end
end

return Collision
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- GROW EVERYTHING (Roblox): Roblox-only settings. Gameplay balance is the web game's own
-- (Shared.WebConfig, exported from game/src/config by tools/roblox-config.mjs); positions and sizes
-- stay in metres there and are converted with STUDS_PER_METER here.

local WebConfig = require(script.Parent:WaitForChild("WebConfig"))

local Config = {}

-- 1 m = 10 studs: the 0.35 m starting machine is 3.5 studs, a 192 m city 1,920 studs and the
-- tallest scenery mesh tile stays under Roblox's 2,048-stud part limit.
Config.STUDS_PER_METER = 10

-- Campaign order of the web arena (world/cities/index.ts).
Config.CITIES = { "shanghai", "newyork", "paris" }

-- Rounds: the web arena's numbers plus a lobby wait between rounds.
Config.INTERMISSION_SECONDS = 15
Config.ROUND_SECONDS = WebConfig.arena.roundSeconds
Config.COUNTDOWN_SECONDS = WebConfig.arena.countdownSeconds
Config.RESULTS_SECONDS = 8
Config.MIN_PLAYERS_TO_START = 1

-- Player machines: the web game's four vehicles, one per player in join order.
Config.MACHINE_LOOKS = { "collector", "dozer", "racer", "magnet" }
-- Slot colours (config/vehicles.ts SLOT_COLORS).
Config.SLOT_COLORS = {
	Color3.fromHex("ffb347"), Color3.fromHex("5ec8ff"), Color3.fromHex("ff6b8a"),
	Color3.fromHex("8be07a"), Color3.fromHex("c89bff"), Color3.fromHex("f5f07a"),
}

-- The server's distance slack when checking a client's claim (positions arrive a little late).
-- (Starter rings, gold and power crates are part of the exported arena layout.)
Config.CLAIM_SLACK = 1.6

-- Monetization (create in the Creator Hub, then paste the ids). 0 = not set up yet.
-- Cosmetics only: nothing you can buy makes you bigger or faster.
Config.GAMEPASS_VIP_TRAIL = 0

-- Remote names (created by the server in ReplicatedStorage.Remotes).
Config.REMOTES = { "Claim", "Crash", "Absorbed", "RoundState", "Notice", "PickVehicle" }

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Growth</string>
          <string name="Source"><![CDATA[--!strict
-- The web game's growth maths (game/src/systems/growth.ts), on WebConfig numbers.
-- Power = the machine's diameter in metres; mass in kg.

local WebConfig = require(script.Parent:WaitForChild("WebConfig"))

local G = WebConfig.growth
local CLASSES = WebConfig.classes

local Growth = {}

function Growth.diameterForMass(mass: number): number
	return G.startDiameter * (mass / G.startMass) ^ G.sizeExponent
end

function Growth.massForDiameter(diameter: number): number
	return G.startMass * (diameter / G.startDiameter) ^ (1 / G.sizeExponent)
end

function Growth.classForPower(power: number): number
	local id = 0
	for _, c in CLASSES do
		if power >= c.requiredPower then
			id = c.id
		end
	end
	return id
end

function Growth.tierForClass(cls: number): number
	local tier = 1
	for _, t in G.tiers do
		if cls >= t.unlockClass then
			tier = t.tier
		end
	end
	return tier
end

function Growth.tierName(tier: number): string
	return G.tiers[tier].name
end

function Growth.classLabel(cls: number): string
	return CLASSES[cls + 1].label
end

-- Progress toward the next class unlock: next class id (or nil at the top), its mass, 0..1.
function Growth.progress(mass: number): (number?, number?, number)
	local cls = Growth.classForPower(Growth.diameterForMass(mass))
	local nextClass = CLASSES[cls + 2]
	if not nextClass then
		return nil, nil, 1
	end
	local from = Growth.massForDiameter(math.max(CLASSES[cls + 1].requiredPower, G.startDiameter))
	local to = Growth.massForDiameter(nextClass.requiredPower)
	return nextClass.id, to, math.clamp((mass - from) / (to - from), 0, 1)
end

-- Required power (diameter, m) to absorb an object type.
function Growth.requiredPower(typeId: string): number
	local def = WebConfig.objects[typeId]
	return def.requiredPower or CLASSES[def.objectClass + 1].requiredPower
end

-- "12.3 kg" under 100, "1,234 kg" under 10 t, then "12.3 t" / "123 t" (arena/ArenaUi.ts massText).
local function commas(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end
function Growth.massText(kg: number): (string, string)
	if kg < 100 then
		return string.format("%.1f", kg), "kg"
	elseif kg < 10000 then
		return commas(kg), "kg"
	elseif kg < 100000 then
		return string.format("%.1f", kg / 1000), "t"
	end
	return commas(kg / 1000), "t"
end

return Growth
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ModelInfo</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by tools/roblox-modelinfo.mjs from roblox/assets/manifest.json — do not edit by hand.
-- size / min: bounding box in metres (web units) and its low corner relative to the model origin;
-- meshes: per MeshPart name {hex colour, material, transparency, tint = takes the instance colour}.

export type MeshInfo = { c: string, m: string, t: number, tint: boolean? }
export type Info = { group: string, size: Vector3, min: Vector3, meshes: { [string]: MeshInfo } }

return {
	Machine_collector_T1 = { group = "machine", size = Vector3.new(0.89, 0.86, 0.996), min = Vector3.new(-0.445, 0, -0.518), meshes = { ["Body_Shell_0"] = { c = "#e8781a", m = "SmoothPlastic", t = 0 }, ["Roller_Core_1"] = { c = "#3a3f44", m = "Metal", t = 0 }, ["Intake_Roller_MAT_darkTrim_2"] = { c = "#1f2123", m = "SmoothPlastic", t = 0 }, ["Intake_GlowStrip_3"] = { c = "#ff9a2a", m = "Neon", t = 0 }, ["Lidar_Puck_4"] = { c = "#1f2123", m = "SmoothPlastic", t = 0 }, ["Lidar_Window_5"] = { c = "#ff9a2a", m = "Neon", t = 0 }, ["Axle_Front_MAT_tread_6"] = { c = "#232325", m = "Rubber", t = 0 }, ["Axle_Front_MAT_Player_Gunmetal_7"] = { c = "#3a3f44", m = "Metal", t = 0 }, ["Axle_Front_MAT_steel_8"] = { c = "#a9afb5", m = "Metal", t = 0 }, ["Tier1_Parts_MAT_Player_Gunmetal_9"] = { c = "#3a3f44", m = "Metal", t = 0 }, ["Tier1_Parts_MAT_darkTrim_10"] = { c = "#1f2123", m = "SmoothPlastic", t = 0 }, ["Tier1_Parts_MAT_steel_11"] = { c = "#a9afb5", m = "Metal", t = 0 }, ["Tier1_Parts_MAT_Player_Hazard_12"] = { c = "#7e6426", m = "SmoothPlastic", t = 0 }, ["Tier1_Parts_MAT_lamps_13"] = { c = "#ffffff", m = "Neon", t = 0 } } },
