          <string name="Source"><![CDATA[--!strict
-- Roblox asset ids of the web game's uploaded models (roblox/upload-assets.sh prints NAME=ID lines;
-- tools/roblox-assetids.mjs turns them into this file). A missing name falls back to primitives.
return {
	BENCH = 138611631166868,
	BICYCLE = 77660789265372,
	BOTTLE = 108630351395907,
	BRICK = 104580403063242,
	BUS_NY = 130675863487731,
	B_BROWNSTONE = 119972156454534,
	B_HAUSSMANN = 130420020141626,
	B_NY_LOFT = 138186698646161,
	B_PARIS_CAFE = 71706374825762,
	B_SHIKUMEN = 95787800842268,
	B_SH_MID = 106240594965064,
	CAFE_TABLE = 132534618247514,
	CAN = 113938279489955,
	CARDBOARD_SMALL = 128560406189085,
	CAR_COMPACT = 132249540238733,
	CHAIR = 87165105534002,
	CUSTOMS_HOUSE = 72753532549865,
	DELIVERY_TRUCK = 71015298311419,
	DUMPSTER = 94008543754708,
	FIRE_HYDRANT = 116763310620835,
	FLATIRON = 96184207458470,
	FOOD_CART = 89258460307955,
	KIOSK = 124483073143302,
	Landmark_Eiffel = 103033788579299,
	Landmark_EmpireState = 121296853358750,
	Landmark_PearlTower = 79495935857628,
	MORRIS_COLUMN = 136212888309963,
	MOTORCYCLE = 80572913447751,
	Machine_collector_T1 = 124151795635831,
	Machine_collector_T2 = 84496922675896,
	Machine_collector_T3 = 132196590142963,
	Machine_collector_T4 = 134632655339702,
	Machine_collector_T5 = 97138777097105,
	Machine_dozer_T1 = 75877321946055,
	Machine_dozer_T2 = 79349586486684,
	Machine_dozer_T3 = 109582550388464,
	Machine_dozer_T4 = 100902154719663,
	Machine_dozer_T5 = 110029802342450,
	Machine_magnet_T1 = 131043132789584,
	Machine_magnet_T2 = 124939715839464,
	Machine_magnet_T3 = 134382303875221,
	Machine_magnet_T4 = 74620633287583,
	Machine_magnet_T5 = 109700180987014,
	Machine_racer_T1 = 113714866980087,
	Machine_racer_T2 = 116249384172367,
	Machine_racer_T3 = 140124728951788,
	Machine_racer_T4 = 116737079034378,
	Machine_racer_T5 = 73666880143467,
	PEACE_HOTEL = 84842363147872,
	SCOOTER = 138132019545062,
	SHOPPING_CART = 70498984894676,
	SUBWAY_ENTRANCE = 77080069834120,
	TAXI_NY = 123306284648727,
	TIMES_TOWER = 128803688862345,
	TRAFFIC_CONE = 111023366292974,
	TRASH_BAG = 114507297232452,
